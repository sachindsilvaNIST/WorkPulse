<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WorkPulse.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="620"
        x:Class="WorkPulse.Views.TripReportEntryDialog"
        x:DataType="vm:TripReportEntryViewModel"
        Title="{Binding WindowTitle}"
        Width="480" Height="640"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <ScrollViewer>
        <Border Padding="20">
            <StackPanel Spacing="12">
                <Border Background="{DynamicResource AppErrorPanel}" Padding="12" CornerRadius="4"
                        IsVisible="{Binding HasValidationError}">
                    <TextBlock Text="{Binding ValidationError}" FontWeight="SemiBold" Foreground="#D13438"/>
                </Border>

                <StackPanel Spacing="4">
                    <TextBlock Text="Trip Type *" FontWeight="SemiBold" FontSize="13"/>
                    <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding TripCategoryIndex}">
                        <ComboBoxItem Content="Domestic Business Trip"/>
                        <ComboBoxItem Content="Overseas Business Trip"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding ShowPrefectureDropdown}">
                    <TextBlock Text="Prefecture *" FontWeight="SemiBold" FontSize="13"/>
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Prefectures}"
                              SelectedItem="{Binding SelectedPrefecture}"/>
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding ShowCountryDropdown}">
                    <TextBlock Text="Country *" FontWeight="SemiBold" FontSize="13"/>
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Countries}"
                              SelectedItem="{Binding SelectedCountry}"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Start Date" FontWeight="SemiBold" FontSize="13"/>
                        <DatePicker SelectedDate="{Binding StartDateInput}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="End Date" FontWeight="SemiBold" FontSize="13"/>
                        <DatePicker SelectedDate="{Binding EndDateInput}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="Purpose *" FontWeight="SemiBold" FontSize="13"/>
                    <TextBox Text="{Binding Purpose}" Watermark="e.g. Client meeting, conference"
                             Padding="10,6" CornerRadius="4"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Notes" FontWeight="SemiBold" FontSize="13"/>
                    <TextBox Text="{Binding Notes}" Watermark="Optional"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                             Padding="10,6" CornerRadius="4"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                            Padding="16,6"
                            Background="{DynamicResource AppButtonNeutral}" Foreground="{DynamicResource AppForeground}"/>
                    <Button Content="Save" Command="{Binding SaveCommand}"
                            Padding="16,6" FontWeight="Bold"
                            Background="#107C10" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
