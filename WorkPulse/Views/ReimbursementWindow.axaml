<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WorkPulse.ViewModels"
        xmlns:m="using:WorkPulse.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="600"
        x:Class="WorkPulse.Views.ReimbursementWindow"
        x:DataType="vm:ReimbursementViewModel"
        Title="Reimbursement — Document Library"
        Width="720" Height="600" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="All your business trip documents in one searchable place."
                       FontSize="12" Foreground="{DynamicResource AppForegroundSecondary}"/>
            <TextBox Text="{Binding SearchText}" Watermark="Search by file name, label, or destination..."
                     Padding="10,6" CornerRadius="6"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" FontSize="12" Margin="0,8,0,0"
                   Foreground="{DynamicResource AppForegroundSecondary}"/>

        <ListBox ItemsSource="{Binding Documents}" BorderThickness="1" BorderBrush="{DynamicResource AppDivider}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="m:TripDocumentWithTrip">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="4,8">
                        <Border Grid.Column="0" Background="#0078D4" CornerRadius="10" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Category}" Foreground="White" FontSize="10"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource AppForegroundSecondary}">
                                <Run Text="{Binding TripDestination}"/> <Run Text=" · "/> <Run Text="{Binding TripStartDate}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Label}" FontSize="11"
                                       Foreground="{DynamicResource AppForegroundSecondary}"
                                       IsVisible="{Binding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Download" Click="DownloadButton_Click" Tag="{Binding}"
                                Padding="8,4" Margin="0,0,4,0" FontSize="11"/>
                        <Button Grid.Column="3" Content="Delete" Click="DeleteButton_Click" Tag="{Binding}"
                                Padding="8,4" FontSize="11" Foreground="#D13438"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
