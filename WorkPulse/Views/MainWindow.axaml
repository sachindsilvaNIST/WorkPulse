<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WorkPulse.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1500" d:DesignHeight="1080"
        x:Class="WorkPulse.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="WorkPulse"
        Icon="/Assets/app-icon.ico"
        Width="1500" Height="900"
        MinWidth="800" MinHeight="500"
        FontSize="{DynamicResource DefaultFontSize}"
        Background="Transparent"
        TransparencyLevelHint="Mica,AcrylicBlur,None">

    <Window.Styles>
        <!-- ===== Apple Blue (#007AFF) buttons ===== -->
        <Style Selector="Button.btn-blue /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.btn-blue:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppControlHover}"/>
        </Style>
        <Style Selector="Button.btn-blue:pointerover">
            <Setter Property="Foreground" Value="#007AFF"/>
        </Style>
        <Style Selector="Button.btn-blue PathIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.btn-blue:pointerover PathIcon">
            <Setter Property="Foreground" Value="#007AFF"/>
        </Style>

        <!-- ===== Primary Blue (#0078D4) buttons ===== -->
        <Style Selector="Button.btn-primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppControlHover}"/>
        </Style>
        <Style Selector="Button.btn-primary:pointerover">
            <Setter Property="Foreground" Value="#0078D4"/>
        </Style>

        <!-- ===== Green (#107C10) buttons ===== -->
        <Style Selector="Button.btn-green /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.btn-green:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppControlHover}"/>
        </Style>
        <Style Selector="Button.btn-green:pointerover">
            <Setter Property="Foreground" Value="#107C10"/>
        </Style>

        <!-- ===== Info Blue (#106EBE) buttons ===== -->
        <Style Selector="Button.btn-info /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.btn-info:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppControlHover}"/>
        </Style>
        <Style Selector="Button.btn-info:pointerover">
            <Setter Property="Foreground" Value="#106EBE"/>
        </Style>

        <!-- ===== Danger Red (#D13438) buttons ===== -->
        <Style Selector="Button.btn-danger /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.btn-danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppControlHover}"/>
        </Style>
        <Style Selector="Button.btn-danger:pointerover">
            <Setter Property="Foreground" Value="#D13438"/>
        </Style>

        <!-- ===== Warning Orange (#FF8C00) buttons ===== -->
        <Style Selector="Button.btn-warning /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.btn-warning:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppControlHover}"/>
        </Style>
        <Style Selector="Button.btn-warning:pointerover">
            <Setter Property="Foreground" Value="#FF8C00"/>
        </Style>

        <!-- ===== Purple (#8B5CF6) buttons ===== -->
        <Style Selector="Button.btn-purple /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.btn-purple:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppControlHover}"/>
        </Style>
        <Style Selector="Button.btn-purple:pointerover">
            <Setter Property="Foreground" Value="#8B5CF6"/>
        </Style>
    </Window.Styles>

    <Grid>
        <!-- Ambient color wash behind every page — subtle, like the web app's aurora backdrop -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="10%,-5%" RadiusX="70%" RadiusY="70%">
                    <GradientStop Color="#14007AFF" Offset="0"/>
                    <GradientStop Color="#00007AFF" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="95%,100%" RadiusX="65%" RadiusY="65%">
                    <GradientStop Color="#128B5CF6" Offset="0"/>
                    <GradientStop Color="#008B5CF6" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

    <DockPanel>
        <!-- Top Toolbar (hidden on Home screen) -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppToolbarGlass}"
                BorderBrush="{DynamicResource AppDivider}"
                BorderThickness="0,0,0,1" Padding="12,8"
                IsVisible="{Binding CurrentViewName, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=True}"
                x:Name="ToolbarBorder">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Home Button + Section Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <!-- Finder-style back button: translucent circular pill with a chevron -->
                    <Button Command="{Binding GoHomeCommand}"
                            Width="30" Height="30" Padding="0" CornerRadius="15"
                            Background="{DynamicResource AppButtonNeutral}"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            ToolTip.Tip="Back to Home">
                        <PathIcon Data="M14.7 5.3a1 1 0 010 1.4L10.41 11l4.3 4.3a1 1 0 01-1.42 1.4l-5-5a1 1 0 010-1.4l5-5a1 1 0 011.42 0z"
                                  Width="14" Height="14"
                                  Foreground="{DynamicResource AppForeground}"/>
                    </Button>
                    <TextBlock x:Name="SectionTitle" Text="Attendance Management"
                               FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppForeground}"/>
                </StackPanel>

                <!-- Toolbar Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">

                    <!-- ===== ATTENDANCE TOOLBAR ===== -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                x:Name="AttendanceToolbar" IsVisible="False">
                        <!-- Edit Mode Toggle -->
                        <Button Classes="btn-primary" Content="{Binding AttendanceDashboard.EditModeButtonText, FallbackValue=Edit}"
                                Command="{Binding AttendanceDashboard.ToggleEditModeCommand}"
                                Padding="14,6" FontWeight="Bold"
                                Background="#0078D4" Foreground="White"
                                ToolTip.Tip="Toggle Edit Mode"/>

                        <Border Width="1" Background="{DynamicResource AppDivider}" Margin="4,2"/>

                        <!-- CRUD buttons (visible only in Edit Mode) -->
                        <Button Classes="btn-blue" Content="+ Entry" Command="{Binding AddEntryCommand}"
                                IsVisible="{Binding AttendanceDashboard.IsEditMode, FallbackValue=False}"
                                Padding="12,6"
                                Background="#007AFF" Foreground="White"
                                ToolTip.Tip="Add new attendance entry"/>
                        <Button Classes="btn-green" Content="+ Holiday" Command="{Binding AddHolidayCommand}"
                                IsVisible="{Binding AttendanceDashboard.IsEditMode, FallbackValue=False}"
                                Padding="12,6"
                                Background="#107C10" Foreground="White"
                                ToolTip.Tip="Add a holiday"/>
                        <Button Classes="btn-info" Content="Edit Row" Command="{Binding EditSelectedEntryCommand}"
                                IsVisible="{Binding AttendanceDashboard.IsEditMode, FallbackValue=False}"
                                Padding="12,6"
                                Background="#106EBE" Foreground="White"
                                ToolTip.Tip="Edit selected entry"/>
                        <Button Classes="btn-danger" Content="Delete" Command="{Binding DeleteEntryCommand}"
                                IsVisible="{Binding AttendanceDashboard.IsEditMode, FallbackValue=False}"
                                Padding="12,6"
                                Background="#D13438" Foreground="White"
                                ToolTip.Tip="Delete selected entry"/>

                        <Border Width="1" Background="{DynamicResource AppDivider}" Margin="4,2"
                                IsVisible="{Binding AttendanceDashboard.IsEditMode, FallbackValue=False}"/>
                    </StackPanel>

                    <!-- ===== CONTACTS TOOLBAR ===== -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                x:Name="ContactsToolbar" IsVisible="False">
                        <!-- Edit Mode Toggle -->
                        <Button Classes="btn-primary" Content="{Binding ContactBookDashboard.EditModeButtonText, FallbackValue=Edit}"
                                Command="{Binding ContactBookDashboard.ToggleEditModeCommand}"
                                Padding="14,6" FontWeight="Bold"
                                Background="#0078D4" Foreground="White"
                                ToolTip.Tip="Toggle Edit Mode"/>

                        <Border Width="1" Background="{DynamicResource AppDivider}" Margin="4,2"/>

                        <!-- CRUD buttons (visible only in Edit Mode) -->
                        <Button Classes="btn-blue" Content="+ Add" Command="{Binding AddContactCommand}"
                                IsVisible="{Binding ContactBookDashboard.IsEditMode, FallbackValue=False}"
                                Padding="12,6"
                                Background="#007AFF" Foreground="White"
                                ToolTip.Tip="Add new contact"/>
                        <Button Classes="btn-info" Content="Edit Contact" Command="{Binding EditContactCommand}"
                                IsVisible="{Binding ContactBookDashboard.IsEditMode, FallbackValue=False}"
                                Padding="12,6"
                                Background="#106EBE" Foreground="White"
                                ToolTip.Tip="Edit selected contact"/>
                        <Button Classes="btn-danger" Content="Delete" Command="{Binding DeleteEntryCommand}"
                                IsVisible="{Binding ContactBookDashboard.IsEditMode, FallbackValue=False}"
                                Padding="12,6"
                                Background="#D13438" Foreground="White"
                                ToolTip.Tip="Delete selected contact"/>

                        <Border Width="1" Background="{DynamicResource AppDivider}" Margin="4,2"
                                IsVisible="{Binding ContactBookDashboard.IsEditMode, FallbackValue=False}"/>
                    </StackPanel>

                    <!-- ===== TRIP REPORTS TOOLBAR ===== -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                x:Name="TripReportsToolbar" IsVisible="False">
                        <Button Classes="btn-primary" Content="{Binding TripReportDashboard.EditModeButtonText, FallbackValue=Edit}"
                                Command="{Binding TripReportDashboard.ToggleEditModeCommand}"
                                Padding="14,6" FontWeight="Bold"
                                Background="#0078D4" Foreground="White"
                                ToolTip.Tip="Toggle Edit Mode"/>
                        <Border Width="1" Background="{DynamicResource AppDivider}" Margin="4,2"/>
                        <Button Classes="btn-blue" Content="+ Add" Command="{Binding AddTripReportCommand}"
                                IsVisible="{Binding TripReportDashboard.IsEditMode, FallbackValue=False}"
                                Padding="12,6" Background="#007AFF" Foreground="White"
                                ToolTip.Tip="Add new business trip report"/>
                        <Button Classes="btn-info" Content="Edit Trip" Command="{Binding EditTripReportCommand}"
                                IsVisible="{Binding TripReportDashboard.IsEditMode, FallbackValue=False}"
                                Padding="12,6" Background="#106EBE" Foreground="White"
                                ToolTip.Tip="Edit selected trip"/>
                        <Button Classes="btn-danger" Content="Delete" Command="{Binding DeleteEntryCommand}"
                                IsVisible="{Binding TripReportDashboard.IsEditMode, FallbackValue=False}"
                                Padding="12,6" Background="#D13438" Foreground="White"
                                ToolTip.Tip="Delete selected trip"/>
                        <Border Width="1" Background="{DynamicResource AppDivider}" Margin="4,2"/>
                        <Button Classes="btn-purple" Content="Documents" Command="{Binding OpenTripDocumentsCommand}"
                                Padding="12,6" Background="#8B5CF6" Foreground="White"
                                ToolTip.Tip="Manage documents for the selected trip"/>
                    </StackPanel>

                    <!-- ===== Import / Export ===== -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                x:Name="ImportExportToolbar" IsVisible="False">
                        <Button Classes="btn-warning" x:Name="ImportExcelBtn"
                                Content="Import Excel" Command="{Binding ImportExcelCommand}"
                                Padding="12,6"
                                Background="#FF8C00" Foreground="White"
                                ToolTip.Tip="Import from Excel file"/>
                        <Button Classes="btn-green" Content="Export Excel" Command="{Binding ExportExcelCommand}"
                                Padding="12,6"
                                Background="#107C10" Foreground="White"
                                ToolTip.Tip="Export to Excel file"/>
                    </StackPanel>

                    <!-- ===== Quick Links (visible whenever the toolbar is shown) ===== -->
                    <Button Command="{Binding OpenQuickLinksCommand}"
                            Padding="8,5"
                            Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Quick Links">
                        <PathIcon Data="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"
                                  Width="18" Height="18"
                                  Foreground="{DynamicResource AppForegroundSecondary}"/>
                    </Button>

                    <!-- ===== Settings Gear (visible when not on home/settings) ===== -->
                    <Button x:Name="ToolbarSettingsBtn"
                            Command="{Binding GoToSettingsCommand}"
                            Padding="8,5"
                            Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Settings (Ctrl+,)">
                        <PathIcon Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.49.49 0 0 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 1 1 12 8.4a3.6 3.6 0 0 1 0 7.2z"
                                  Width="18" Height="18"
                                  Foreground="{DynamicResource AppForegroundSecondary}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource AppBackgroundAlt}"
                BorderBrush="{DynamicResource AppDivider}"
                BorderThickness="0,1,0,0" Padding="12,6">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <!-- Status Message -->
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12"
                           Foreground="{DynamicResource AppForegroundSecondary}"
                           VerticalAlignment="Center"/>
                <!-- Module Name -->
                <TextBlock Grid.Column="1" x:Name="StatusModuleName" Text=""
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppForegroundSecondary}"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <!-- Live Clock -->
                <TextBlock Grid.Column="2" x:Name="ClockText" Text=""
                           FontSize="12" FontFamily="Consolas,Monospace"
                           Foreground="{DynamicResource AppForegroundSecondary}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Dynamic Content Area -->
        <Border Padding="16">
            <TransitioningContentControl x:Name="ContentArea" Content="{Binding CurrentView}"/>
        </Border>
    </DockPanel>
    </Grid>
</Window>
