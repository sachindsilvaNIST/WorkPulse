<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WorkPulse.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="600"
             x:Class="WorkPulse.Views.TripReportView"
             x:DataType="vm:TripReportViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText}"
                         Watermark="Search by destination, purpose, notes..."
                         FontSize="14" Padding="12,8" CornerRadius="6"
                         BorderBrush="{DynamicResource AppDivider}"
                         Margin="0,0,8,0"/>
                <Button Grid.Column="1" Command="{Binding ClearSearchCommand}"
                        Padding="8,6" Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Center" Margin="0,0,8,0" ToolTip.Tip="Clear search">
                    <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                              Width="16" Height="16" Foreground="{DynamicResource AppForegroundSecondary}"/>
                </Button>
                <Border Grid.Column="2" Background="{DynamicResource AppBackgroundAlt}" CornerRadius="6" Padding="16,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Total:" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppForegroundSecondary}"/>
                        <TextBlock Text="{Binding TotalReports}" FontWeight="Bold" VerticalAlignment="Center"
                                   FontSize="16" Foreground="#0078D4"/>
                        <TextBlock Text="trips" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppForegroundSecondary}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid>
            <ListBox ItemsSource="{Binding FilteredReports}"
                     SelectedItem="{Binding SelectedReport}"
                     BorderThickness="1" BorderBrush="{DynamicResource AppDivider}" CornerRadius="6">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,Auto,*" Margin="4,8">
                            <Border Grid.Column="0" Background="#0078D4" CornerRadius="10"
                                    Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Category}" Foreground="White" FontSize="11"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Destination}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock FontSize="11" Foreground="{DynamicResource AppForegroundSecondary}">
                                    <Run Text="{Binding StartDate}"/> <Run Text=" - "/> <Run Text="{Binding EndDate}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Purpose}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="No business trip reports found. Click Add to create one."
                       IsVisible="{Binding HasNoReports}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="16" Foreground="{DynamicResource AppForegroundSecondary}"/>
        </Grid>
    </DockPanel>
</UserControl>
