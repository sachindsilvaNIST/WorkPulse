@page "/markdown-editor"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>WorkPulse · Notes</PageTitle>

<div class="flex flex-col h-[calc(100vh-7rem)]">

    @* ── Toolbar ── *@
    <div class="flex items-center gap-1 px-3 py-1.5 bg-app-bg border-b border-app-divider flex-wrap">
        @* Headings *@
        <button class="md-tool-btn" @onclick='() => ToolbarAction("heading", "1")' title="Heading 1">H1</button>
        <button class="md-tool-btn" @onclick='() => ToolbarAction("heading", "2")' title="Heading 2">H2</button>
        <button class="md-tool-btn" @onclick='() => ToolbarAction("heading", "3")' title="Heading 3">H3</button>
        <span class="w-px h-5 bg-app-divider mx-1"></span>

        @* Formatting *@
        <button class="md-tool-btn" @onclick='() => ToolbarAction("bold", "")' title="Bold (Ctrl+B)">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 4h8a4 4 0 014 4 4 4 0 01-4 4H6z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 12h9a4 4 0 014 4 4 4 0 01-4 4H6z"/></svg>
        </button>
        <button class="md-tool-btn" @onclick='() => ToolbarAction("italic", "")' title="Italic (Ctrl+I)">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 4h4m-2 0l-4 16m0 0h4"/></svg>
        </button>
        <button class="md-tool-btn" @onclick='() => ToolbarAction("strikethrough", "")' title="Strikethrough">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 4H9a3 3 0 00-3 3v0a3 3 0 003 3h6a3 3 0 013 3v0a3 3 0 01-3 3H8m-4-8h16"/></svg>
        </button>
        <button class="md-tool-btn" @onclick='() => ToolbarAction("inline-code", "")' title="Inline code">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        </button>
        <span class="w-px h-5 bg-app-divider mx-1"></span>

        @* Insert *@
        <button class="md-tool-btn" @onclick='() => ToolbarAction("link", "")' title="Link (Ctrl+K)">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
        </button>
        <button class="md-tool-btn" @onclick='() => ToolbarAction("image-url", "")' title="Image from URL">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </button>
        <span class="w-px h-5 bg-app-divider mx-1"></span>

        @* Lists *@
        <button class="md-tool-btn" @onclick='() => ToolbarAction("ul", "")' title="Unordered list">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <button class="md-tool-btn" @onclick='() => ToolbarAction("ol", "")' title="Ordered list">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h8"/></svg>
        </button>
        <button class="md-tool-btn" @onclick='() => ToolbarAction("task-list", "")' title="Task list">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
        </button>
        <span class="w-px h-5 bg-app-divider mx-1"></span>

        @* Blocks *@
        <button class="md-tool-btn" @onclick='() => ToolbarAction("blockquote", "")' title="Blockquote">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M4.583 17.321C3.553 16.227 3 15 3 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311C9.591 11.69 11 13.2 11 15c0 1.87-1.412 3.379-3.333 3.379-1.05 0-2.05-.5-3.084-1.058zM14.583 17.321C13.553 16.227 13 15 13 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311C19.591 11.69 21 13.2 21 15c0 1.87-1.412 3.379-3.333 3.379-1.05 0-2.05-.5-3.084-1.058z"/></svg>
        </button>
        <button class="md-tool-btn" @onclick='() => ToolbarAction("code-block", "")' title="Code block">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </button>
        <button class="md-tool-btn" @onclick='() => ToolbarAction("table", "")' title="Table">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18M10 3v18M14 3v18M3 6a3 3 0 013-3h12a3 3 0 013 3v12a3 3 0 01-3 3H6a3 3 0 01-3-3V6z"/></svg>
        </button>
        <button class="md-tool-btn" @onclick='() => ToolbarAction("hr", "")' title="Horizontal rule">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14"/></svg>
        </button>

        <span class="flex-1"></span>

        @* Actions *@
        <button class="btn-outline text-xs !px-2 !py-1" @onclick="DownloadMarkdown" title="Download .md">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            .md
        </button>
        <button class="btn-primary text-xs !px-2 !py-1" @onclick="ExportHtml" title="Export HTML">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
            Export HTML
        </button>

        <span class="w-px h-5 bg-app-divider mx-1"></span>

        @* View modes *@
        <button class="md-tool-btn @(viewMode == "editor" ? "md-tool-active" : "")" @onclick='() => SetViewMode("editor")' title="Editor only">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        </button>
        <button class="md-tool-btn @(viewMode == "preview" ? "md-tool-active" : "")" @onclick='() => SetViewMode("preview")' title="Preview only">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
        </button>
        <button class="md-tool-btn @(viewMode == "split" ? "md-tool-active" : "")" @onclick='() => SetViewMode("split")' title="Split view">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7"/></svg>
        </button>
    </div>

    @* ── Split Panes ── *@
    <div id="md-main" class="flex flex-1 overflow-hidden">

        @* Editor *@
        <div id="md-editor-pane" class="flex flex-col flex-1 min-w-0 overflow-hidden">
            <div class="flex items-center gap-1.5 px-3 py-1 bg-app-bg-alt border-b border-app-divider text-xs font-semibold text-app-fg-secondary uppercase tracking-wide">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                Editor
            </div>
            <div class="md-editor-wrapper flex-1 overflow-hidden relative">
                <textarea id="md-textarea"></textarea>
            </div>
        </div>

        @* Divider *@
        <div id="md-divider" class="md-divider">
            <div class="md-divider-handle"></div>
        </div>

        @* Preview *@
        <div id="md-preview-pane" class="flex flex-col flex-1 min-w-0 overflow-hidden">
            <div class="flex items-center gap-1.5 px-3 py-1 bg-app-bg-alt border-b border-app-divider text-xs font-semibold text-app-fg-secondary uppercase tracking-wide">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                Preview
            </div>
            <div class="md-preview-wrapper flex-1 overflow-y-auto px-6 py-4 bg-app-bg">
                <div id="md-preview" class="md-body"></div>
            </div>
        </div>
    </div>

    @* ── Status Bar ── *@
    <div class="flex items-center justify-between px-3 py-1 bg-app-bg-alt border-t border-app-divider text-[11px] text-app-fg-secondary">
        <div class="flex items-center gap-2">
            <span id="stat-lines">Lines: 0</span>
            <span class="text-app-divider">|</span>
            <span id="stat-words">Words: 0</span>
            <span class="text-app-divider">|</span>
            <span id="stat-chars">Chars: 0</span>
            <span class="text-app-divider">|</span>
            <span id="stat-cursor">Ln 1, Col 1</span>
        </div>
        <span>Markdown</span>
    </div>
</div>

@code {
    private string viewMode = "split";
    private DotNetObjectReference<MarkdownEditor>? dotnetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotnetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("MarkdownEditor.init", "md-textarea", dotnetRef);
            await JS.InvokeVoidAsync("MarkdownEditor.initDivider");
        }
    }

    private async Task ToolbarAction(string action, string level)
    {
        await JS.InvokeVoidAsync("MarkdownEditor.toolbarAction", action, level);
    }

    private async Task SetViewMode(string mode)
    {
        viewMode = mode;
        await JS.InvokeVoidAsync("MarkdownEditor.setViewMode", mode);
    }

    private async Task DownloadMarkdown()
    {
        var content = await JS.InvokeAsync<string>("MarkdownEditor.getContent");
        var bytes = System.Text.Encoding.UTF8.GetBytes(content);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("eval", $"(() => {{ const a=document.createElement('a'); a.href='data:text/markdown;base64,{base64}'; a.download='document.md'; a.click(); }})()");
    }

    private async Task ExportHtml()
    {
        var html = await JS.InvokeAsync<string>("MarkdownEditor.getRenderedHtml");
        var fullHtml = $@"<!DOCTYPE html>
<html lang=""en"">
<head>
<meta charset=""UTF-8"">
<meta name=""viewport"" content=""width=device-width, initial-scale=1.0"">
<title>Markdown Export</title>
<link rel=""stylesheet"" href=""https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css"">
<style>
body {{ font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; max-width: 860px; margin: 2rem auto; padding: 0 1.5rem; line-height: 1.7; color: #24292f; }}
pre {{ background: #f6f8fa; padding: 1rem; border-radius: 6px; overflow-x: auto; }}
code {{ font-family: 'SFMono-Regular', Consolas, monospace; font-size: 0.9em; }}
img {{ max-width: 100%; border-radius: 6px; }}
table {{ border-collapse: collapse; width: 100%; }}
th, td {{ border: 1px solid #d0d7de; padding: 8px 12px; }}
blockquote {{ border-left: 4px solid #d0d7de; margin: 0; padding: 0.5rem 1rem; color: #656d76; }}
a {{ color: #0969da; }}
hr {{ border: none; border-top: 1px solid #d0d7de; }}
</style>
</head>
<body>
{html}
<script src=""https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js""></script>
<script>hljs.highlightAll();</script>
</body>
</html>";

        var bytes = System.Text.Encoding.UTF8.GetBytes(fullHtml);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("eval", $"(() => {{ const a=document.createElement('a'); a.href='data:text/html;base64,{base64}'; a.download='document.html'; a.click(); }})()");
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("MarkdownEditor.dispose"); } catch { }
        dotnetRef?.Dispose();
    }
}
