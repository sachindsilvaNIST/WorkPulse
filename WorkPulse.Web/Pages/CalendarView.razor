@page "/calendar"
@using Microsoft.AspNetCore.Authorization
@using WorkPulse.Models
@using WorkPulse.Services
@attribute [Authorize]

<PageTitle>WorkPulse · Calendar</PageTitle>
@inject IDataService DataService

<div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-4">
    <h3 class="text-xl font-semibold text-app-fg">Calendar View</h3>
    <div class="flex items-center gap-3">
        <button class="btn-outline" @onclick="PrevMonth">&lt;</button>
        <h5 class="text-lg font-medium text-app-fg min-w-[140px] text-center">@_monthLabel @_year</h5>
        <button class="btn-outline" @onclick="NextMonth">&gt;</button>
        <button class="btn-outline text-xs" @onclick="GoToToday">Today</button>
    </div>
</div>

<!-- Legend -->
<div class="flex flex-wrap gap-3 mb-4 text-xs">
    <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-nist-primary"></span> Work Day</span>
    <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-amber-400"></span> Leave</span>
    <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-emerald-400"></span> Holiday</span>
    <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-blue-400"></span> Trip</span>
    <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-gray-300"></span> Weekend</span>
    <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-orange-400"></span> Overtime</span>
</div>

@if (_loading)
{
    <div class="text-center py-12"><div class="spinner-primary"></div></div>
}
else
{
    <!-- Day headers -->
    <div class="grid grid-cols-7 gap-px bg-app-divider rounded-t-lg overflow-hidden">
        @foreach (var day in new[] { "MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN" })
        {
            <div class="bg-app-bg-alt px-1 py-2 text-center text-xs font-semibold text-app-fg-secondary @(day is "SAT" or "SUN" ? "text-nist-danger" : "")">
                @day
            </div>
        }
    </div>

    <!-- Calendar grid -->
    <div class="grid grid-cols-7 gap-px bg-app-divider rounded-b-lg overflow-hidden">
        @foreach (var cell in _calendarCells)
        {
            <div class="bg-app-bg min-h-[60px] sm:min-h-[90px] p-1 @(cell.IsCurrentMonth ? "" : "opacity-30") @(cell.IsToday ? "ring-2 ring-inset ring-nist-primary" : "") cursor-pointer hover:bg-app-bg-alt transition-colors"
                 @onclick="() => ShowDayDetail(cell)">
                <div class="text-xs font-medium text-app-fg @(cell.Date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday ? "text-nist-danger" : "")">
                    @cell.Date.Day
                </div>
                @if (cell.Record != null)
                {
                    <div class="mt-0.5">
                        <!-- Color dot indicating type -->
                        <div class="w-full h-1.5 rounded-full @GetDotClass(cell.Record) mb-0.5"></div>

                        <!-- Desktop: show details -->
                        <div class="hidden sm:block text-[10px] leading-tight text-app-fg-secondary">
                            @if (cell.Record.DayType == DayType.WorkDay && cell.Record.LoginTime.HasValue)
                            {
                                <div>@cell.Record.LoginTime.Value.ToString("H:mm")-@cell.Record.LogoutTime?.ToString("H:mm")</div>
                            }
                            else
                            {
                                <div>@GetTypeLabel(cell.Record)</div>
                            }
                            @if (cell.Record.IsOvertime)
                            {
                                <div class="text-orange-500 font-semibold">OT @cell.Record.OvertimeHours:@cell.Record.OvertimeMinutes.ToString("D2")</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Summary -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4">
        <div class="nist-card px-3 py-2 text-center">
            <div class="text-xs text-app-fg-secondary uppercase">Work Days</div>
            <div class="text-lg font-bold text-nist-primary">@(_monthData?.TotalWorkDays ?? 0)</div>
        </div>
        <div class="nist-card px-3 py-2 text-center">
            <div class="text-xs text-app-fg-secondary uppercase">Overtime</div>
            <div class="text-lg font-bold text-orange-500">@(_monthData?.OvertimeCount ?? 0)</div>
        </div>
        <div class="nist-card px-3 py-2 text-center">
            <div class="text-xs text-app-fg-secondary uppercase">Total OT</div>
            @{ var (h, m) = _monthData?.TotalOvertimeDuration ?? (0, 0); }
            <div class="text-lg font-bold text-amber-500">@h:@m.ToString("D2")</div>
        </div>
        <div class="nist-card px-3 py-2 text-center">
            <div class="text-xs text-app-fg-secondary uppercase">Leaves</div>
            <div class="text-lg font-bold text-nist-info">@(_monthData?.Records.Count(r => r.DayType is DayType.AnnualPaidLeave or DayType.UnpaidLeave) ?? 0)</div>
        </div>
    </div>
}

@* Day Detail Popup *@
@if (_showDayDetail && _selectedCell != null)
{
    <div class="modal-overlay" @onclick="() => _showDayDetail = false">
        <div class="modal-panel max-w-sm" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <h5 class="text-lg font-semibold text-app-fg">@_selectedCell.Date.ToString("dddd")</h5>
                    <p class="text-sm text-app-fg-secondary">@_selectedCell.Date.ToString("MMMM d, yyyy")</p>
                </div>
                <button class="text-app-fg-secondary hover:text-app-fg text-xl" @onclick="() => _showDayDetail = false">&times;</button>
            </div>
            <div class="modal-body">
                @if (_selectedCell.Record != null)
                {
                    var r = _selectedCell.Record;
                    <div class="space-y-3">
                        <div class="flex justify-between">
                            <span class="text-sm text-app-fg-secondary">Type</span>
                            <span class="text-sm font-medium text-app-fg">@GetTypeLabel(r)</span>
                        </div>
                        @if (r.DayType == DayType.WorkDay)
                        {
                            <div class="flex justify-between">
                                <span class="text-sm text-app-fg-secondary">Login</span>
                                <span class="text-sm font-medium text-app-fg">@r.LoginTime?.ToString("H:mm")</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-sm text-app-fg-secondary">Logout</span>
                                <span class="text-sm font-medium text-app-fg">@r.LogoutTime?.ToString("H:mm")</span>
                            </div>
                            @if (r.IsOvertimeDecided)
                            {
                                <div class="flex justify-between">
                                    <span class="text-sm text-app-fg-secondary">Overtime</span>
                                    <span class="text-sm font-medium @(r.IsOvertime ? "text-orange-500" : "text-app-fg")">
                                        @(r.IsOvertime ? $"{r.OvertimeHours}h {r.OvertimeMinutes}m" : "No")
                                    </span>
                                </div>
                            }
                        }
                        @if (!string.IsNullOrEmpty(r.HolidayName))
                        {
                            <div class="flex justify-between">
                                <span class="text-sm text-app-fg-secondary">Description</span>
                                <span class="text-sm font-medium text-app-fg">@r.HolidayName</span>
                            </div>
                        }
                        @if (r.TripCategory != null)
                        {
                            <div class="flex justify-between">
                                <span class="text-sm text-app-fg-secondary">Trip</span>
                                <span class="text-sm font-medium text-app-fg">@r.TripCategory — @r.TripRegion</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-center text-app-fg-secondary py-4">No entry for this day</p>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-primary" @onclick="() => _showDayDetail = false">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private int _year = DateTime.Now.Year;
    private int _month = DateTime.Now.Month;
    private string _monthLabel = "";
    private MonthlyData? _monthData;
    private List<CalendarCell> _calendarCells = new();
    private bool _loading = true;

    private bool _showDayDetail;
    private CalendarCell? _selectedCell;

    protected override async Task OnInitializedAsync()
    {
        await LoadMonth();
    }

    private async Task LoadMonth()
    {
        _loading = true;
        _monthLabel = new DateTime(_year, _month, 1).ToString("MMMM");
        _monthData = await DataService.LoadMonthAsync(_year, _month);
        BuildCalendarCells();
        _loading = false;
    }

    private void BuildCalendarCells()
    {
        _calendarCells.Clear();
        var firstDay = new DateOnly(_year, _month, 1);
        var daysInMonth = DateTime.DaysInMonth(_year, _month);
        var today = DateOnly.FromDateTime(DateTime.Now);

        // Monday=0 offset
        var startOffset = ((int)firstDay.DayOfWeek + 6) % 7;

        // Fill leading days from previous month
        for (var i = startOffset - 1; i >= 0; i--)
        {
            var date = firstDay.AddDays(-(i + 1));
            _calendarCells.Add(new CalendarCell { Date = date, IsCurrentMonth = false, IsToday = date == today });
        }

        // Current month days
        var records = _monthData?.Records.ToDictionary(r => r.Date) ?? new();
        for (var d = 1; d <= daysInMonth; d++)
        {
            var date = new DateOnly(_year, _month, d);
            records.TryGetValue(date, out var record);
            _calendarCells.Add(new CalendarCell
            {
                Date = date,
                IsCurrentMonth = true,
                IsToday = date == today,
                Record = record
            });
        }

        // Fill trailing days to complete grid (always 6 rows = 42 cells)
        while (_calendarCells.Count < 42)
        {
            var date = firstDay.AddDays(_calendarCells.Count - startOffset);
            _calendarCells.Add(new CalendarCell { Date = date, IsCurrentMonth = false, IsToday = date == today });
        }
    }

    private async Task PrevMonth()
    {
        _month--;
        if (_month < 1) { _month = 12; _year--; }
        await LoadMonth();
    }

    private async Task NextMonth()
    {
        _month++;
        if (_month > 12) { _month = 1; _year++; }
        await LoadMonth();
    }

    private async Task GoToToday()
    {
        _year = DateTime.Now.Year;
        _month = DateTime.Now.Month;
        await LoadMonth();
    }

    private void ShowDayDetail(CalendarCell cell)
    {
        _selectedCell = cell;
        _showDayDetail = true;
    }

    private static string GetDotClass(AttendanceRecord r) => r.DayType switch
    {
        DayType.WorkDay when r.IsOvertime => "bg-orange-400",
        DayType.WorkDay => "bg-nist-primary",
        DayType.AnnualPaidLeave or DayType.UnpaidLeave => "bg-amber-400",
        DayType.PublicHoliday => "bg-emerald-400",
        DayType.BusinessTrip => "bg-blue-400",
        DayType.Weekend => "bg-gray-300",
        _ => "bg-gray-300"
    };

    private static string GetTypeLabel(AttendanceRecord r) => r.DayType switch
    {
        DayType.WorkDay => "Work",
        DayType.AnnualPaidLeave => "Leave",
        DayType.UnpaidLeave => "Unpaid",
        DayType.PublicHoliday => r.HolidayName ?? "Holiday",
        DayType.BusinessTrip => "Trip",
        DayType.Weekend => "Weekend",
        _ => ""
    };

    private class CalendarCell
    {
        public DateOnly Date { get; set; }
        public bool IsCurrentMonth { get; set; }
        public bool IsToday { get; set; }
        public AttendanceRecord? Record { get; set; }
    }
}
