@page "/reimbursement"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using WorkPulse.Models
@inject WorkPulse.Web.Services.ApiReimbursementService ReimbursementService
@inject WorkPulse.Web.Services.ApiTripDocumentService DocService
@inject WorkPulse.Web.Services.ToastService Toast
@inject IJSRuntime JS

<PageTitle>WorkPulse · Reimbursement</PageTitle>

<div class="mb-4">
    <h4 class="text-xl font-semibold text-app-fg">Reimbursement</h4>
    <p class="text-sm text-app-fg-secondary mt-1">Every invoice, receipt, ticket, and document from every business trip — in one searchable place.</p>
</div>

<input class="nist-input mb-4" placeholder="Search by file name, label, or destination..." value="@_search" @oninput="OnSearchInput" />

@if (_loading)
{
    <div class="text-center py-12"><div class="spinner-primary"></div></div>
}
else if (!_documents.Any())
{
    <div class="nist-card nist-card-body text-center text-app-fg-secondary py-12">
        @(string.IsNullOrWhiteSpace(_search) ? "No documents yet. Upload some from a trip's Documents panel." : "No documents match your search.")
    </div>
}
else
{
    <div class="flex flex-col gap-2">
        @foreach (var d in _documents)
        {
            <div class="nist-card nist-card-body flex items-center justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                    <span class="badge-info shrink-0">@d.Category</span>
                    <div class="min-w-0">
                        <div class="font-semibold text-app-fg truncate">@d.FileName</div>
                        <div class="text-xs text-app-fg-secondary">
                            <a href="/reports/trips" class="hover:underline">@d.TripDestination</a>
                            · @d.TripStartDate.ToString("yyyy-MM-dd")
                            @if (!string.IsNullOrWhiteSpace(d.Label))
                            {
                                <span> · @d.Label</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="flex gap-1 shrink-0">
                    <button class="btn-outline text-xs !px-2 !py-1" @onclick="() => Download(d)">Download</button>
                    <button class="btn-danger text-xs !px-2 !py-1" @onclick="() => Delete(d)">Del</button>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<TripDocumentWithTrip> _documents = new();
    private bool _loading = true;
    private string _search = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadDocuments();
    }

    private async Task LoadDocuments()
    {
        _loading = true;
        _documents = await ReimbursementService.GetAllDocumentsAsync(string.IsNullOrWhiteSpace(_search) ? null : _search);
        _loading = false;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _ = LoadDocuments();
        StateHasChanged();
    }

    private async Task Download(TripDocumentWithTrip doc)
    {
        var (success, content, contentType) = await DocService.DownloadAsync(doc.TripReportId, doc.Id);
        if (!success || content == null)
        {
            Toast.Error("Download failed.");
            return;
        }

        var base64 = Convert.ToBase64String(content);
        await JS.InvokeVoidAsync("FileDownload.download", doc.FileName, contentType ?? doc.ContentType, base64);
    }

    private async Task Delete(TripDocumentWithTrip doc)
    {
        await DocService.DeleteAsync(doc.TripReportId, doc.Id);
        Toast.Success("Document deleted.");
        await LoadDocuments();
    }
}
