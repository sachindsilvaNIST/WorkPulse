@page "/dictionary"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject WorkPulse.Web.Services.ApiDictionaryService DictService
@inject IJSRuntime JS

<!-- Header -->
<div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-4">
    <div>
        <h3 class="text-xl font-semibold text-app-fg">JP / Jisho Dictionary</h3>
        <p class="text-sm text-app-fg-secondary">@_entries.Count words &middot; @_labels.Count labels</p>
    </div>
    <div class="flex flex-wrap gap-2">
        <button class="btn-primary" @onclick="ShowAddEntry">+ New</button>
        <button class="btn-info" @onclick="() => _showLabelManager = true">Labels</button>
    </div>
</div>

<!-- Search + Label Filter -->
<div class="flex flex-col sm:flex-row gap-3 mb-4">
    <input type="text" class="nist-input flex-1" placeholder="Search Japanese, reading, meaning..."
           @bind="_searchText" @bind:event="oninput" @bind:after="LoadEntries" />

    <select class="nist-input sm:w-48" @bind="_selectedLabelId" @bind:after="LoadEntries">
        <option value="0">All Labels</option>
        @foreach (var label in _labels)
        {
            <option value="@label.Id">@label.Name (@label.EntryCount)</option>
        }
    </select>

    <select class="nist-input sm:w-36" @bind="_selectedJlpt" @bind:after="LoadEntries">
        <option value="">All JLPT</option>
        <option value="N5">N5</option>
        <option value="N4">N4</option>
        <option value="N3">N3</option>
        <option value="N2">N2</option>
        <option value="N1">N1</option>
    </select>
</div>

<!-- Entries -->
@if (_loading)
{
    <div class="text-center py-12"><div class="spinner-primary"></div></div>
}
else if (!_entries.Any())
{
    <div class="nist-card">
        <div class="nist-card-body text-center py-12">
            <p class="text-app-fg-secondary text-lg">No words found</p>
            <p class="text-app-fg-secondary text-sm mt-1">
                @if (!string.IsNullOrWhiteSpace(_searchText) || _selectedLabelId > 0)
                {
                    <span>Try adjusting your search or label filter</span>
                }
                else
                {
                    <span>Click <strong>+ New</strong> to add your first word</span>
                }
            </p>
        </div>
    </div>
}
else
{
    <!-- Desktop: Table view -->
    <div class="hidden md:block overflow-x-auto">
        <table class="nist-table">
            <thead>
                <tr>
                    <th class="w-40">Japanese</th>
                    <th class="w-36">Reading</th>
                    <th>Meaning</th>
                    <th class="w-48">Labels</th>
                    <th class="w-28">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in _entries)
                {
                    <tr class="cursor-pointer hover:bg-blue-50/50 transition-colors" @onclick="() => ShowDetail(entry)">
                        <td class="text-lg font-medium">
                            <div class="flex items-center gap-1 flex-wrap">
                                <span>@entry.Japanese</span>
                                <button type="button" class="text-app-fg-secondary hover:text-nist-primary text-base" title="Play pronunciation"
                                        @onclick:stopPropagation="true" @onclick="() => Speak(entry.Japanese)">🔊</button>
                                @if (!string.IsNullOrEmpty(entry.JlptLevel))
                                {
                                    <span class="inline-block px-1.5 py-0.5 text-[10px] font-bold rounded text-white" style="background-color: @JlptColor(entry.JlptLevel)">@entry.JlptLevel</span>
                                }
                            </div>
                        </td>
                        <td class="text-app-fg-secondary">@entry.Reading</td>
                        <td>
                            <div>@entry.Meaning</div>
                            @if (!string.IsNullOrEmpty(entry.ExampleJp))
                            {
                                <div class="text-xs text-app-fg-secondary mt-1 italic">@entry.ExampleJp</div>
                            }
                        </td>
                        <td>
                            <div class="flex flex-wrap gap-1">
                                @foreach (var label in entry.Labels)
                                {
                                    <span class="inline-block px-2 py-0.5 text-xs rounded-full text-white" style="background-color: @label.Color">@label.Name</span>
                                }
                            </div>
                        </td>
                        <td>
                            <div class="flex gap-1" @onclick:stopPropagation="true">
                                <button class="btn-outline text-xs !px-2 !py-1" @onclick="() => ShowEditEntry(entry)">Edit</button>
                                <button class="btn-danger text-xs !px-2 !py-1" @onclick="() => ShowDeleteConfirm(entry)">Del</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Mobile: Card view -->
    <div class="md:hidden flex flex-col gap-3">
        @foreach (var entry in _entries)
        {
            <div class="nist-card cursor-pointer active:bg-gray-50 transition-colors" @onclick="() => ShowDetail(entry)">
                <div class="nist-card-body">
                    <div class="flex justify-between items-start">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <div class="text-xl font-medium text-app-fg">@entry.Japanese</div>
                                <button type="button" class="text-app-fg-secondary hover:text-nist-primary text-lg" title="Play pronunciation"
                                        @onclick:stopPropagation="true" @onclick="() => Speak(entry.Japanese)">🔊</button>
                                @if (!string.IsNullOrEmpty(entry.JlptLevel))
                                {
                                    <span class="inline-block px-1.5 py-0.5 text-[10px] font-bold rounded text-white" style="background-color: @JlptColor(entry.JlptLevel)">@entry.JlptLevel</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(entry.Reading))
                            {
                                <div class="text-sm text-app-fg-secondary">@entry.Reading</div>
                            }
                            <div class="mt-1 text-app-fg truncate">@entry.Meaning</div>
                        </div>
                        <svg class="w-5 h-5 text-app-fg-secondary shrink-0 ml-2 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                    </div>
                    @if (entry.Labels.Any())
                    {
                        <div class="flex flex-wrap gap-1 mt-2">
                            @foreach (var label in entry.Labels)
                            {
                                <span class="inline-block px-2 py-0.5 text-xs rounded-full text-white" style="background-color: @label.Color">@label.Name</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@* Detail Panel *@
@if (_showDetail && _detailEntry != null)
{
    <div class="modal-overlay" @onclick="() => _showDetail = false">
        <div class="modal-panel max-w-lg" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <h5 class="text-2xl font-bold text-app-fg">@_detailEntry.Japanese</h5>
                        <button type="button" class="text-app-fg-secondary hover:text-nist-primary text-xl" title="Play pronunciation"
                                @onclick="() => Speak(_detailEntry!.Japanese)">🔊</button>
                        @if (!string.IsNullOrEmpty(_detailEntry.JlptLevel))
                        {
                            <span class="inline-block px-2 py-0.5 text-xs font-bold rounded text-white" style="background-color: @JlptColor(_detailEntry.JlptLevel)">@_detailEntry.JlptLevel</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(_detailEntry.Reading))
                    {
                        <p class="text-app-fg-secondary mt-0.5">@_detailEntry.Reading</p>
                    }
                </div>
                <button class="text-app-fg-secondary hover:text-app-fg text-xl" @onclick="() => _showDetail = false">&times;</button>
            </div>
            <div class="modal-body space-y-4">
                <!-- Meaning -->
                <div>
                    <div class="text-xs font-semibold text-app-fg-secondary uppercase tracking-wide mb-1">Meaning</div>
                    <div class="text-app-fg text-lg">@_detailEntry.Meaning</div>
                </div>

                <!-- Examples -->
                @if (!string.IsNullOrEmpty(_detailEntry.ExampleJp) || !string.IsNullOrEmpty(_detailEntry.ExampleEn))
                {
                    <div class="bg-app-bg-alt rounded-lg p-3 border border-app-divider">
                        <div class="text-xs font-semibold text-app-fg-secondary uppercase tracking-wide mb-2">Examples</div>
                        @if (!string.IsNullOrEmpty(_detailEntry.ExampleJp))
                        {
                            <div class="flex items-start gap-2">
                                <div class="text-app-fg flex-1">@_detailEntry.ExampleJp</div>
                                <button type="button" class="text-app-fg-secondary hover:text-nist-primary" title="Play example"
                                        @onclick="() => Speak(_detailEntry!.ExampleJp!)">🔊</button>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_detailEntry.ExampleEn))
                        {
                            <div class="text-app-fg-secondary text-sm mt-1 italic">@_detailEntry.ExampleEn</div>
                        }
                    </div>
                }

                <!-- Notes -->
                @if (!string.IsNullOrEmpty(_detailEntry.Notes))
                {
                    <div>
                        <div class="text-xs font-semibold text-app-fg-secondary uppercase tracking-wide mb-1">Notes</div>
                        <div class="text-app-fg text-sm whitespace-pre-wrap dict-notes-render">@((MarkupString)SanitizeHtml(_detailEntry.Notes))</div>
                    </div>
                }

                <!-- Labels -->
                @if (_detailEntry.Labels.Any())
                {
                    <div>
                        <div class="text-xs font-semibold text-app-fg-secondary uppercase tracking-wide mb-2">Labels</div>
                        <div class="flex flex-wrap gap-1">
                            @foreach (var label in _detailEntry.Labels)
                            {
                                <span class="inline-block px-3 py-1 text-xs rounded-full text-white" style="background-color: @label.Color">@label.Name</span>
                            }
                        </div>
                    </div>
                }

                <!-- Meta -->
                <div class="text-xs text-app-fg-secondary pt-2 border-t border-app-divider">
                    Added @_detailEntry.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd") &middot;
                    Updated @_detailEntry.LastModifiedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-outline" @onclick="() => { _showDetail = false; ShowEditEntry(_detailEntry); }">Edit</button>
                <button class="btn-danger" @onclick="() => { _showDetail = false; ShowDeleteConfirm(_detailEntry); }">Delete</button>
                <button class="btn-primary" @onclick="() => _showDetail = false">Close</button>
            </div>
        </div>
    </div>
}

@* Entry Modal *@
@if (_showEntryModal)
{
    <WorkPulse.Web.Components.DictionaryEntryModal
        Entry="_editEntry"
        IsEdit="_isEdit"
        Labels="_labels"
        OnSave="HandleEntrySave"
        OnCancel="() => _showEntryModal = false" />
}

@* Delete Confirm *@
@if (_showDeleteConfirm)
{
    <div class="modal-overlay">
        <div class="modal-panel max-w-md">
            <div class="modal-header">
                <h5 class="text-lg font-semibold text-app-fg">Delete Entry</h5>
            </div>
            <div class="modal-body">
                Delete <strong class="text-lg">@_deleteTarget?.Japanese</strong> (@_deleteTarget?.Meaning)?
            </div>
            <div class="modal-footer">
                <button class="btn-outline" @onclick="() => _showDeleteConfirm = false">Cancel</button>
                <button class="btn-danger" @onclick="ConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
}

@* Label Manager *@
@if (_showLabelManager)
{
    <WorkPulse.Web.Components.LabelManager
        Labels="_labels"
        OnClose="HandleLabelManagerClose" />
}

@code {
    private List<WorkPulse.Web.Services.DictEntryDto> _entries = new();
    private List<WorkPulse.Web.Services.DictLabelDto> _labels = new();
    private bool _loading = true;
    private string _searchText = "";
    private int _selectedLabelId;
    private string _selectedJlpt = "";

    private bool _showEntryModal;
    private bool _isEdit;
    private WorkPulse.Web.Services.DictEntryDto? _editEntry;

    private bool _showDeleteConfirm;
    private WorkPulse.Web.Services.DictEntryDto? _deleteTarget;

    private bool _showLabelManager;

    private bool _showDetail;
    private WorkPulse.Web.Services.DictEntryDto? _detailEntry;

    protected override async Task OnInitializedAsync()
    {
        await LoadLabels();
        await LoadEntries();
    }

    private async Task LoadEntries()
    {
        _loading = true;
        _entries = await DictService.GetEntriesAsync(
            string.IsNullOrWhiteSpace(_searchText) ? null : _searchText,
            _selectedLabelId > 0 ? _selectedLabelId : null,
            string.IsNullOrWhiteSpace(_selectedJlpt) ? null : _selectedJlpt);
        _loading = false;
    }

    private static string JlptColor(string? level) => level switch
    {
        "N5" => "#10B981",
        "N4" => "#84CC16",
        "N3" => "#EAB308",
        "N2" => "#F97316",
        "N1" => "#EF4444",
        _ => "#6B7280"
    };

    private async Task LoadLabels()
    {
        _labels = await DictService.GetLabelsAsync();
    }

    private void ShowAddEntry()
    {
        _editEntry = null;
        _isEdit = false;
        _showEntryModal = true;
    }

    private void ShowEditEntry(WorkPulse.Web.Services.DictEntryDto entry)
    {
        _editEntry = entry;
        _isEdit = true;
        _showEntryModal = true;
    }

    private void ShowDetail(WorkPulse.Web.Services.DictEntryDto entry)
    {
        _detailEntry = entry;
        _showDetail = true;
    }

    private async Task HandleEntrySave(WorkPulse.Web.Services.DictEntryCreateDto dto)
    {
        if (_isEdit && _editEntry != null)
            await DictService.UpdateEntryAsync(_editEntry.Id, dto);
        else
            await DictService.CreateEntryAsync(dto);

        _showEntryModal = false;
        await LoadLabels();
        await LoadEntries();
    }

    private void ShowDeleteConfirm(WorkPulse.Web.Services.DictEntryDto entry)
    {
        _deleteTarget = entry;
        _showDeleteConfirm = true;
    }

    private async Task ConfirmDelete()
    {
        if (_deleteTarget != null)
        {
            await DictService.DeleteEntryAsync(_deleteTarget.Id);
            _showDeleteConfirm = false;
            await LoadLabels();
            await LoadEntries();
        }
    }

    private async Task HandleLabelManagerClose()
    {
        _showLabelManager = false;
        await LoadLabels();
        await LoadEntries();
    }

    private async Task Speak(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        await JS.InvokeVoidAsync("speakText", text, "ja-JP");
    }

    private static string SanitizeHtml(string html)
    {
        return html
            .Replace("<script", "&lt;script")
            .Replace("</script", "&lt;/script")
            .Replace("onerror", "")
            .Replace("onclick", "")
            .Replace("onload", "");
    }
}
