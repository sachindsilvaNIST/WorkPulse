@page "/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using WorkPulse.Models
@inject WorkPulse.Web.Services.ApiSettingsService SettingsService
@inject IJSRuntime JS

<PageTitle>WorkPulse · Settings</PageTitle>

<h4 class="text-xl font-semibold text-app-fg mb-6">Settings</h4>

@if (_loading)
{
    <div class="text-center py-12">
        <div class="spinner-primary"></div>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Appearance -->
        <div class="nist-card">
            <div class="nist-card-header">Appearance</div>
            <div class="nist-card-body space-y-4">
                <!-- Theme Toggle -->
                <div class="flex items-center justify-between">
                    <div>
                        <div class="text-sm font-medium text-app-fg">Dark Mode</div>
                        <div class="text-xs text-app-fg-secondary">Switch between light and dark appearance</div>
                    </div>
                    <button class="relative w-11 h-6 rounded-full transition-colors @(_theme == "Dark" ? "bg-nist-primary" : "bg-gray-300")"
                            @onclick="ToggleTheme">
                        <span class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform @(_theme == "Dark" ? "translate-x-5" : "")"></span>
                    </button>
                </div>

                <!-- Font Size -->
                <div class="flex items-center justify-between">
                    <div>
                        <div class="text-sm font-medium text-app-fg">Font Size</div>
                        <div class="text-xs text-app-fg-secondary">Adjust text size across the app</div>
                    </div>
                    <select class="nist-input w-32" @bind="_fontSize">
                        <option value="Small">Small</option>
                        <option value="Medium">Medium</option>
                        <option value="Large">Large</option>
                    </select>
                </div>

                <!-- Accent Color -->
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <div>
                            <div class="text-sm font-medium text-app-fg">Accent Color</div>
                            <div class="text-xs text-app-fg-secondary">Customize primary color used across UI</div>
                        </div>
                        <button class="text-xs text-nist-primary hover:underline" @onclick="ResetAccent">Reset</button>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var preset in _accentPresets)
                        {
                            var color = preset;
                            <button type="button"
                                    class="w-8 h-8 rounded-full border-2 transition-transform hover:scale-110 @(string.Equals(_accent, color, StringComparison.OrdinalIgnoreCase) ? "border-app-fg ring-2 ring-offset-2 ring-app-fg/30" : "border-app-divider")"
                                    style="background-color: @color"
                                    title="@color"
                                    @onclick="() => SetAccent(color)"></button>
                        }
                        <label class="w-8 h-8 rounded-full border-2 border-app-divider cursor-pointer flex items-center justify-center text-xs overflow-hidden relative" title="Custom color">
                            <input type="color" class="absolute inset-0 opacity-0 cursor-pointer" value="@_accent" @onchange="OnAccentPicked" />
                            <span class="text-app-fg-secondary">+</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Work Schedule -->
        <div class="nist-card">
            <div class="nist-card-header">Work Schedule</div>
            <div class="nist-card-body grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-app-fg-secondary mb-1">Standard Login</label>
                    <input type="time" class="nist-input" @bind="_loginTime" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-app-fg-secondary mb-1">Standard Logout</label>
                    <input type="time" class="nist-input" @bind="_logoutTime" />
                </div>
                <div class="col-span-2">
                    <label class="block text-sm font-medium text-app-fg-secondary mb-1">OT Break Deduction (minutes)</label>
                    <input type="number" class="nist-input" min="0" max="120" @bind="_breakMinutes" />
                </div>
            </div>
        </div>

        <!-- Save -->
        <div class="col-span-1 md:col-span-2">
            <button class="btn-primary w-full sm:w-auto justify-center" @onclick="SaveSettings" disabled="@_saving">
                @if (_saving) { <span class="spinner"></span> }
                Save Settings
            </button>

            @if (_saved)
            {
                <span class="text-nist-success ml-3">Settings saved.</span>
            }
            @if (!string.IsNullOrEmpty(_error))
            {
                <span class="text-nist-danger ml-3">@_error</span>
            }
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private bool _saved;
    private string? _error;

    private TimeOnly _loginTime = new(8, 20);
    private TimeOnly _logoutTime = new(17, 25);
    private int _breakMinutes = 20;
    private string _defaultTitle = "MSW SETTLEMENT";
    private string _theme = "Light";
    private string _fontSize = "Medium";
    private string _accent = "#0078D4";

    private readonly string[] _accentPresets =
    {
        "#0078D4", // NIST blue (default)
        "#107C10", // green
        "#8B5CF6", // purple
        "#D13438", // red
        "#FF8C00", // orange
        "#E91E63", // pink
        "#00838F", // teal
        "#424242"  // slate
    };

    protected override async Task OnInitializedAsync()
    {
        // Load server settings
        var s = await SettingsService.LoadAsync();
        _loginTime = s.StandardLoginTime;
        _logoutTime = s.StandardLogoutTime;
        _breakMinutes = s.OvertimeBreakDeductionMinutes;
        _defaultTitle = s.DefaultTitle;
        _fontSize = s.FontSizePreset;

        // Load theme + accent from localStorage (local to browser, instant)
        _theme = await JS.InvokeAsync<string>("getTheme");
        _accent = await JS.InvokeAsync<string>("getAccent");
        _loading = false;
    }

    private async Task ToggleTheme()
    {
        _theme = _theme == "Dark" ? "Light" : "Dark";
        await JS.InvokeVoidAsync("setTheme", _theme);
    }

    private async Task SetAccent(string hex)
    {
        _accent = hex;
        await JS.InvokeVoidAsync("setAccent", hex);
    }

    private async Task OnAccentPicked(ChangeEventArgs e)
    {
        var hex = e.Value?.ToString();
        if (!string.IsNullOrEmpty(hex))
            await SetAccent(hex);
    }

    private async Task ResetAccent()
    {
        _accent = "#0078D4";
        await JS.InvokeVoidAsync("resetAccent");
    }

    private async Task SaveSettings()
    {
        _saving = true;
        _saved = false;
        _error = null;

        try
        {
            var settings = new AppSettings
            {
                StandardLoginTime = _loginTime,
                StandardLogoutTime = _logoutTime,
                OvertimeBreakDeductionMinutes = _breakMinutes,
                DefaultTitle = _defaultTitle,
                ThemeVariant = _theme,
                FontSizePreset = _fontSize
            };
            await SettingsService.SaveAsync(settings);
            _saved = true;
        }
        catch (Exception ex)
        {
            _error = $"Failed to save: {ex.Message}";
        }

        _saving = false;
    }
}
