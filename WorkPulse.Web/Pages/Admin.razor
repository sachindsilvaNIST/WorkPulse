@page "/admin"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject WorkPulse.Web.Services.ToastService Toast

<div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-6">
    <div>
        <h3 class="text-xl font-semibold text-app-fg">User Management</h3>
        <p class="text-sm text-app-fg-secondary mt-1">Manage registered user accounts</p>
    </div>
    <div class="flex items-center gap-2">
        <span class="badge-info">@_users.Count accounts</span>
        <button class="btn-primary" @onclick="ShowCreateUser">+ Create User</button>
    </div>
</div>

@if (_loading)
{
    <div class="text-center py-12">
        <div class="spinner-primary"></div>
    </div>
}
else
{
    <div class="nist-card">
        <table class="nist-table">
            <thead>
                <tr>
                    <th>Display Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th class="w-64">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!_users.Any())
                {
                    <tr><td colspan="5" class="text-center text-app-fg-secondary py-8">No users found.</td></tr>
                }
                @foreach (var user in _users)
                {
                    <tr class="@(user.IsDisabled ? "opacity-50" : "")">
                        <td class="font-medium">@user.DisplayName</td>
                        <td>@user.Email</td>
                        <td>
                            @if (user.IsAdmin)
                            {
                                <span class="badge-warning">Admin</span>
                            }
                            else
                            {
                                <span class="badge-info">User</span>
                            }
                        </td>
                        <td>
                            @if (user.IsDisabled)
                            {
                                <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-red-100 text-red-700">Disabled</span>
                            }
                            else
                            {
                                <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-green-100 text-green-700">Active</span>
                            }
                        </td>
                        <td>
                            <div class="flex flex-wrap gap-1">
                                <button class="btn-info text-xs !px-2 !py-1" @onclick="() => EditUser(user)">Edit</button>
                                <button class="btn-outline text-xs !px-2 !py-1" @onclick="() => ShowFeatures(user)" disabled="@user.IsAdmin" title="@(user.IsAdmin ? "Admins always have all features" : "Manage feature access")">Features</button>
                                <button class="@(user.IsDisabled ? "btn-green" : "btn-outline") text-xs !px-2 !py-1" @onclick="() => ToggleDisable(user)" disabled="@user.IsCurrentUser" title="@(user.IsDisabled ? "Re-enable account" : "Disable account")">
                                    @(user.IsDisabled ? "Enable" : "Disable")
                                </button>
                                <button class="btn-warning text-xs !px-2 !py-1" @onclick="() => ShowResetPassword(user)">Reset PW</button>
                                <button class="btn-danger text-xs !px-2 !py-1" @onclick="() => ShowDeleteConfirm(user)" disabled="@user.IsCurrentUser">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Create User Modal *@
@if (_showCreateModal)
{
    <div class="modal-overlay">
        <div class="modal-panel max-w-md">
            <div class="modal-header">
                <h5 class="text-lg font-semibold">Create User</h5>
                <button class="text-app-fg-secondary hover:text-app-fg text-xl" @onclick="() => _showCreateModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-app-fg mb-1">Display Name *</label>
                        <input type="text" class="nist-input" @bind="_createDisplayName" placeholder="e.g., Sachin Dsilva" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-app-fg mb-1">Email *</label>
                        <input type="email" class="nist-input" @bind="_createEmail" placeholder="e.g., user@example.com" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-app-fg mb-1">Password * (min 6 chars)</label>
                        <input type="password" class="nist-input" @bind="_createPassword" />
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="checkbox" id="createIsAdmin" @bind="_createIsAdmin" class="w-4 h-4" />
                        <label for="createIsAdmin" class="text-sm text-app-fg">Admin Role</label>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_createError))
                {
                    <div class="mt-3 text-sm text-nist-danger">@_createError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-outline" @onclick="() => _showCreateModal = false">Cancel</button>
                <button class="btn-primary" @onclick="CreateUser">Create</button>
            </div>
        </div>
    </div>
}

@* Edit User Modal *@
@if (_showEditModal)
{
    <div class="modal-overlay">
        <div class="modal-panel max-w-md">
            <div class="modal-header">
                <h5 class="text-lg font-semibold">Edit User</h5>
                <button class="text-app-fg-secondary hover:text-app-fg text-xl" @onclick="() => _showEditModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-app-fg mb-1">Display Name</label>
                        <input type="text" class="nist-input" @bind="_editDisplayName" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-app-fg mb-1">Email</label>
                        <input type="email" class="nist-input" @bind="_editEmail" />
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="checkbox" id="isAdmin" @bind="_editIsAdmin" class="w-4 h-4" />
                        <label for="isAdmin" class="text-sm text-app-fg">Admin Role</label>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_editError))
                {
                    <div class="mt-3 text-sm text-nist-danger">@_editError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-outline" @onclick="() => _showEditModal = false">Cancel</button>
                <button class="btn-primary" @onclick="SaveEdit">Save</button>
            </div>
        </div>
    </div>
}

@* Reset Password Modal *@
@if (_showResetModal)
{
    <div class="modal-overlay">
        <div class="modal-panel max-w-md">
            <div class="modal-header">
                <h5 class="text-lg font-semibold">Reset Password</h5>
                <button class="text-app-fg-secondary hover:text-app-fg text-xl" @onclick="() => _showResetModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <p class="text-sm text-app-fg-secondary mb-4">Reset password for <strong>@_targetUser?.DisplayName</strong></p>
                <div>
                    <label class="block text-sm font-medium text-app-fg mb-1">New Password (min 6 chars)</label>
                    <input type="password" class="nist-input" @bind="_newPassword" />
                </div>
                @if (!string.IsNullOrEmpty(_resetError))
                {
                    <div class="mt-3 text-sm text-nist-danger">@_resetError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-outline" @onclick="() => _showResetModal = false">Cancel</button>
                <button class="btn-warning" @onclick="ResetPassword">Reset</button>
            </div>
        </div>
    </div>
}

@* Features Modal *@
@if (_showFeaturesModal)
{
    <div class="modal-overlay">
        <div class="modal-panel max-w-md">
            <div class="modal-header">
                <h5 class="text-lg font-semibold">Feature Access</h5>
                <button class="text-app-fg-secondary hover:text-app-fg text-xl" @onclick="() => _showFeaturesModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <p class="text-sm text-app-fg-secondary mb-3">Toggle which modules <strong>@_targetUser?.DisplayName</strong> can access. Disabled modules are hidden from their nav and routes.</p>
                @if (_featuresLoading)
                {
                    <div class="text-center py-4"><div class="spinner-primary"></div></div>
                }
                else
                {
                    <div class="space-y-2">
                        @foreach (var feat in _featureCatalog)
                        {
                            var enabled = !_disabledFeatures.Contains(feat);
                            <label class="flex items-center justify-between gap-3 px-3 py-2 rounded border border-app-divider cursor-pointer hover:bg-app-bg-alt">
                                <span class="text-sm text-app-fg capitalize">@feat</span>
                                <input type="checkbox" class="w-4 h-4" checked="@enabled" @onchange="e => ToggleFeature(feat, (bool)e.Value!)" />
                            </label>
                        }
                    </div>
                    <p class="text-xs text-app-fg-secondary mt-3">Changes apply on the user's next login (their JWT is refreshed at sign-in).</p>
                }
                @if (!string.IsNullOrEmpty(_featuresError))
                {
                    <div class="mt-3 text-sm text-nist-danger">@_featuresError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-outline" @onclick="() => _showFeaturesModal = false">Cancel</button>
                <button class="btn-primary" @onclick="SaveFeatures" disabled="@_featuresLoading">Save</button>
            </div>
        </div>
    </div>
}

@* Delete Confirm Modal *@
@if (_showDeleteModal)
{
    <div class="modal-overlay">
        <div class="modal-panel max-w-md">
            <div class="modal-header">
                <h5 class="text-lg font-semibold">Delete User</h5>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong>@_targetUser?.DisplayName</strong> (@_targetUser?.Email)?</p>
                <p class="text-sm text-nist-danger mt-2">This will permanently remove all their attendance data, contacts, and settings.</p>
            </div>
            <div class="modal-footer">
                <button class="btn-outline" @onclick="() => _showDeleteModal = false">Cancel</button>
                <button class="btn-danger" @onclick="ConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<UserInfo> _users = new();
    private bool _loading = true;

    private bool _showCreateModal;
    private string _createDisplayName = "";
    private string _createEmail = "";
    private string _createPassword = "";
    private bool _createIsAdmin;
    private string? _createError;

    private bool _showEditModal;
    private bool _showResetModal;
    private bool _showDeleteModal;
    private UserInfo? _targetUser;

    private string _editDisplayName = "";
    private string _editEmail = "";
    private bool _editIsAdmin;
    private string? _editError;

    private string _newPassword = "";
    private string? _resetError;

    private bool _showFeaturesModal;
    private bool _featuresLoading;
    private string? _featuresError;
    private List<string> _featureCatalog = new();
    private HashSet<string> _disabledFeatures = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        _loading = true;
        try
        {
            var users = await Http.GetFromJsonAsync<List<AdminUserResponse>>("api/admin/users");
            _users = users?.Select(u => new UserInfo
            {
                Id = u.Id,
                Email = u.Email,
                DisplayName = u.DisplayName,
                IsAdmin = u.IsAdmin,
                IsDisabled = u.IsDisabled,
                IsCurrentUser = false
            }).ToList() ?? new();
        }
        catch { }
        _loading = false;
    }

    private void ShowCreateUser()
    {
        _createDisplayName = "";
        _createEmail = "";
        _createPassword = "";
        _createIsAdmin = false;
        _createError = null;
        _showCreateModal = true;
    }

    private async Task CreateUser()
    {
        _createError = null;
        if (string.IsNullOrWhiteSpace(_createDisplayName) || string.IsNullOrWhiteSpace(_createEmail))
        {
            _createError = "Display name and email are required.";
            return;
        }
        if (_createPassword.Length < 6)
        {
            _createError = "Password must be at least 6 characters.";
            return;
        }
        try
        {
            var response = await Http.PostAsJsonAsync("api/admin/users", new
            {
                Email = _createEmail,
                DisplayName = _createDisplayName,
                Password = _createPassword,
                IsAdmin = _createIsAdmin
            });
            if (response.IsSuccessStatusCode)
            {
                _showCreateModal = false;
                Toast.Success($"User '{_createDisplayName}' created.");
                await LoadUsers();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _createError = error.Contains("errors") ? "Failed: check password requirements (uppercase, number, special char)." : "Failed to create user.";
            }
        }
        catch (Exception ex)
        {
            _createError = ex.Message;
        }
    }

    private async Task ToggleDisable(UserInfo user)
    {
        try
        {
            var response = await Http.PostAsync($"api/admin/users/{user.Id}/toggle-disable", null);
            if (response.IsSuccessStatusCode)
            {
                var action = user.IsDisabled ? "enabled" : "disabled";
                Toast.Success($"User '{user.DisplayName}' {action}.");
                await LoadUsers();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Toast.Error(body.Contains("own account") ? "Cannot disable your own account." : "Failed to toggle user status.");
            }
        }
        catch
        {
            Toast.Error("Failed to toggle user status.");
        }
    }

    private void EditUser(UserInfo user)
    {
        _targetUser = user;
        _editDisplayName = user.DisplayName;
        _editEmail = user.Email;
        _editIsAdmin = user.IsAdmin;
        _editError = null;
        _showEditModal = true;
    }

    private async Task SaveEdit()
    {
        _editError = null;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/admin/users/{_targetUser!.Id}", new
            {
                Email = _editEmail,
                DisplayName = _editDisplayName,
                IsAdmin = _editIsAdmin
            });
            if (response.IsSuccessStatusCode)
            {
                _showEditModal = false;
                Toast.Success($"User '{_editDisplayName}' updated.");
                await LoadUsers();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                _editError = body.Contains("admin role") ? "Cannot remove your own admin role."
                           : body.Contains("one admin") ? "At least one admin must remain."
                           : "Failed to update user.";
            }
        }
        catch (Exception ex)
        {
            _editError = ex.Message;
        }
    }

    private void ShowResetPassword(UserInfo user)
    {
        _targetUser = user;
        _newPassword = "";
        _resetError = null;
        _showResetModal = true;
    }

    private async Task ResetPassword()
    {
        _resetError = null;
        if (_newPassword.Length < 6)
        {
            _resetError = "Password must be at least 6 characters.";
            return;
        }
        try
        {
            var response = await Http.PostAsJsonAsync($"api/admin/users/{_targetUser!.Id}/reset-password", new { NewPassword = _newPassword });
            if (response.IsSuccessStatusCode)
            {
                _showResetModal = false;
                Toast.Success($"Password reset for '{_targetUser.DisplayName}'.");
            }
            else
            {
                _resetError = "Failed to reset password.";
            }
        }
        catch (Exception ex)
        {
            _resetError = ex.Message;
        }
    }

    private async Task ShowFeatures(UserInfo user)
    {
        _targetUser = user;
        _featuresError = null;
        _showFeaturesModal = true;
        _featuresLoading = true;
        try
        {
            var resp = await Http.GetFromJsonAsync<UserFeaturesResponse>($"api/admin/users/{user.Id}/features");
            _featureCatalog = resp?.Catalog ?? new();
            _disabledFeatures = new HashSet<string>(resp?.Disabled ?? new(), StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            _featuresError = ex.Message;
        }
        _featuresLoading = false;
    }

    private void ToggleFeature(string key, bool enabled)
    {
        if (enabled) _disabledFeatures.Remove(key);
        else _disabledFeatures.Add(key);
    }

    private async Task SaveFeatures()
    {
        _featuresError = null;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/admin/users/{_targetUser!.Id}/features",
                new { Disabled = _disabledFeatures.ToList() });
            if (response.IsSuccessStatusCode)
            {
                _showFeaturesModal = false;
                Toast.Success($"Features updated for '{_targetUser!.DisplayName}'.");
            }
            else
            {
                _featuresError = "Failed to update features.";
            }
        }
        catch (Exception ex)
        {
            _featuresError = ex.Message;
        }
    }

    private void ShowDeleteConfirm(UserInfo user)
    {
        _targetUser = user;
        _showDeleteModal = true;
    }

    private async Task ConfirmDelete()
    {
        try
        {
            var name = _targetUser!.DisplayName;
            var response = await Http.DeleteAsync($"api/admin/users/{_targetUser.Id}");
            _showDeleteModal = false;
            if (response.IsSuccessStatusCode)
            {
                Toast.Success($"User '{name}' deleted.");
                await LoadUsers();
            }
            else
            {
                Toast.Error("Failed to delete user.");
            }
        }
        catch
        {
            Toast.Error("Failed to delete user.");
        }
    }

    private class UserInfo
    {
        public string Id { get; set; } = "";
        public string Email { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public bool IsAdmin { get; set; }
        public bool IsDisabled { get; set; }
        public bool IsCurrentUser { get; set; }
    }

    private class AdminUserResponse
    {
        public string Id { get; set; } = "";
        public string Email { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public bool IsAdmin { get; set; }
        public bool IsDisabled { get; set; }
    }

    private class UserFeaturesResponse
    {
        public List<string> Catalog { get; set; } = new();
        public List<string> Disabled { get; set; } = new();
    }
}
