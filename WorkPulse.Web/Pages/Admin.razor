@page "/admin"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http

<div class="flex justify-between items-center mb-6">
    <div>
        <h3 class="text-xl font-semibold text-app-fg">User Management</h3>
        <p class="text-sm text-app-fg-secondary mt-1">Manage registered user accounts</p>
    </div>
    <span class="badge-info">@_users.Count accounts</span>
</div>

@if (_loading)
{
    <div class="text-center py-12">
        <div class="spinner-primary"></div>
    </div>
}
else
{
    <div class="nist-card">
        <table class="nist-table">
            <thead>
                <tr>
                    <th>Display Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th class="w-48">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!_users.Any())
                {
                    <tr><td colspan="4" class="text-center text-app-fg-secondary py-8">No users found.</td></tr>
                }
                @foreach (var user in _users)
                {
                    <tr>
                        <td class="font-medium">@user.DisplayName</td>
                        <td>@user.Email</td>
                        <td>
                            @if (user.IsAdmin)
                            {
                                <span class="badge-warning">Admin</span>
                            }
                            else
                            {
                                <span class="badge-info">User</span>
                            }
                        </td>
                        <td>
                            <div class="flex gap-1">
                                <button class="btn-info text-xs !px-2 !py-1" @onclick="() => EditUser(user)">Edit</button>
                                <button class="btn-warning text-xs !px-2 !py-1" @onclick="() => ShowResetPassword(user)">Reset PW</button>
                                <button class="btn-danger text-xs !px-2 !py-1" @onclick="() => ShowDeleteConfirm(user)" disabled="@user.IsCurrentUser">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Edit User Modal *@
@if (_showEditModal)
{
    <div class="modal-overlay">
        <div class="modal-panel max-w-md">
            <div class="modal-header">
                <h5 class="text-lg font-semibold">Edit User</h5>
                <button class="text-app-fg-secondary hover:text-app-fg text-xl" @onclick="() => _showEditModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-app-fg mb-1">Display Name</label>
                        <input type="text" class="nist-input" @bind="_editDisplayName" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-app-fg mb-1">Email</label>
                        <input type="email" class="nist-input" @bind="_editEmail" />
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="checkbox" id="isAdmin" @bind="_editIsAdmin" class="w-4 h-4" />
                        <label for="isAdmin" class="text-sm text-app-fg">Admin Role</label>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_editError))
                {
                    <div class="mt-3 text-sm text-nist-danger">@_editError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-outline" @onclick="() => _showEditModal = false">Cancel</button>
                <button class="btn-primary" @onclick="SaveEdit">Save</button>
            </div>
        </div>
    </div>
}

@* Reset Password Modal *@
@if (_showResetModal)
{
    <div class="modal-overlay">
        <div class="modal-panel max-w-md">
            <div class="modal-header">
                <h5 class="text-lg font-semibold">Reset Password</h5>
                <button class="text-app-fg-secondary hover:text-app-fg text-xl" @onclick="() => _showResetModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <p class="text-sm text-app-fg-secondary mb-4">Reset password for <strong>@_targetUser?.DisplayName</strong></p>
                <div>
                    <label class="block text-sm font-medium text-app-fg mb-1">New Password (min 6 chars)</label>
                    <input type="password" class="nist-input" @bind="_newPassword" />
                </div>
                @if (!string.IsNullOrEmpty(_resetError))
                {
                    <div class="mt-3 text-sm text-nist-danger">@_resetError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-outline" @onclick="() => _showResetModal = false">Cancel</button>
                <button class="btn-warning" @onclick="ResetPassword">Reset</button>
            </div>
        </div>
    </div>
}

@* Delete Confirm Modal *@
@if (_showDeleteModal)
{
    <div class="modal-overlay">
        <div class="modal-panel max-w-md">
            <div class="modal-header">
                <h5 class="text-lg font-semibold">Delete User</h5>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong>@_targetUser?.DisplayName</strong> (@_targetUser?.Email)?</p>
                <p class="text-sm text-nist-danger mt-2">This will permanently remove all their attendance data, contacts, and settings.</p>
            </div>
            <div class="modal-footer">
                <button class="btn-outline" @onclick="() => _showDeleteModal = false">Cancel</button>
                <button class="btn-danger" @onclick="ConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<UserInfo> _users = new();
    private bool _loading = true;

    private bool _showEditModal;
    private bool _showResetModal;
    private bool _showDeleteModal;
    private UserInfo? _targetUser;

    private string _editDisplayName = "";
    private string _editEmail = "";
    private bool _editIsAdmin;
    private string? _editError;

    private string _newPassword = "";
    private string? _resetError;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        _loading = true;
        try
        {
            var users = await Http.GetFromJsonAsync<List<AdminUserResponse>>("api/admin/users");
            _users = users?.Select(u => new UserInfo
            {
                Id = u.Id,
                Email = u.Email,
                DisplayName = u.DisplayName,
                IsAdmin = u.IsAdmin,
                IsCurrentUser = false // We can't easily determine this client-side
            }).ToList() ?? new();
        }
        catch { }
        _loading = false;
    }

    private void EditUser(UserInfo user)
    {
        _targetUser = user;
        _editDisplayName = user.DisplayName;
        _editEmail = user.Email;
        _editIsAdmin = user.IsAdmin;
        _editError = null;
        _showEditModal = true;
    }

    private async Task SaveEdit()
    {
        _editError = null;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/admin/users/{_targetUser!.Id}", new
            {
                Email = _editEmail,
                DisplayName = _editDisplayName,
                IsAdmin = _editIsAdmin
            });
            if (response.IsSuccessStatusCode)
            {
                _showEditModal = false;
                await LoadUsers();
            }
            else
            {
                _editError = "Failed to update user.";
            }
        }
        catch (Exception ex)
        {
            _editError = ex.Message;
        }
    }

    private void ShowResetPassword(UserInfo user)
    {
        _targetUser = user;
        _newPassword = "";
        _resetError = null;
        _showResetModal = true;
    }

    private async Task ResetPassword()
    {
        _resetError = null;
        if (_newPassword.Length < 6)
        {
            _resetError = "Password must be at least 6 characters.";
            return;
        }
        try
        {
            var response = await Http.PostAsJsonAsync($"api/admin/users/{_targetUser!.Id}/reset-password", new { NewPassword = _newPassword });
            if (response.IsSuccessStatusCode)
            {
                _showResetModal = false;
            }
            else
            {
                _resetError = "Failed to reset password.";
            }
        }
        catch (Exception ex)
        {
            _resetError = ex.Message;
        }
    }

    private void ShowDeleteConfirm(UserInfo user)
    {
        _targetUser = user;
        _showDeleteModal = true;
    }

    private async Task ConfirmDelete()
    {
        try
        {
            await Http.DeleteAsync($"api/admin/users/{_targetUser!.Id}");
            _showDeleteModal = false;
            await LoadUsers();
        }
        catch { }
    }

    private class UserInfo
    {
        public string Id { get; set; } = "";
        public string Email { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public bool IsAdmin { get; set; }
        public bool IsCurrentUser { get; set; }
    }

    private class AdminUserResponse
    {
        public string Id { get; set; } = "";
        public string Email { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public bool IsAdmin { get; set; }
    }
}
