@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inject WorkPulse.Web.Services.FeatureService Features
@inject AuthenticationStateProvider AuthState

<div class="text-center mt-6 sm:mt-12">
    <h1 class="text-2xl sm:text-3xl font-bold text-app-fg">WorkPulse</h1>
    <p class="text-app-fg-secondary mt-2">Attendance Management System</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 mt-8 sm:mt-10 px-4 sm:px-0 max-w-5xl mx-auto">
        <div class="nist-card hover:shadow-md transition-shadow h-full">
            <div class="nist-card-body text-center">
                <svg class="w-12 h-12 mx-auto text-nist-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                <h5 class="text-lg font-semibold mt-4 text-app-fg">Attendance</h5>
                <p class="text-sm text-app-fg-secondary mt-2">Track daily attendance, overtime, and business trips</p>
                <a href="dashboard" class="btn-primary mt-4">Open</a>
            </div>
        </div>
        @if (_enabled.Contains("contacts"))
        {
            <div class="nist-card hover:shadow-md transition-shadow h-full">
                <div class="nist-card-body text-center">
                    <svg class="w-12 h-12 mx-auto text-nist-success" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                    <h5 class="text-lg font-semibold mt-4 text-app-fg">Contacts</h5>
                    <p class="text-sm text-app-fg-secondary mt-2">Manage your professional contact book</p>
                    <a href="contacts" class="btn-green mt-4">Open</a>
                </div>
            </div>
        }
        @if (_enabled.Contains("dictionary"))
        {
            <div class="nist-card hover:shadow-md transition-shadow h-full">
                <div class="nist-card-body text-center">
                    <svg class="w-12 h-12 mx-auto text-nist-info" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                    <h5 class="text-lg font-semibold mt-4 text-app-fg">JP Dictionary</h5>
                    <p class="text-sm text-app-fg-secondary mt-2">Store and search Japanese words and phrases</p>
                    <a href="dictionary" class="btn-info mt-4">Open</a>
                </div>
            </div>
        }
        @if (_enabled.Contains("notes"))
        {
            <div class="nist-card hover:shadow-md transition-shadow h-full">
                <div class="nist-card-body text-center">
                    <svg class="w-12 h-12 mx-auto text-nist-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                    <h5 class="text-lg font-semibold mt-4 text-app-fg">Markdown Editor</h5>
                    <p class="text-sm text-app-fg-secondary mt-2">Write and preview Markdown with live rendering</p>
                    <a href="markdown-editor" class="btn-purple mt-4">Open</a>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private HashSet<string> _enabled = new(WorkPulse.Web.Services.FeatureService.Catalog, StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var disabled = await Features.GetDisabledAsync();
        _enabled = WorkPulse.Web.Services.FeatureService.Catalog
            .Where(f => !disabled.Contains(f))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }
}
