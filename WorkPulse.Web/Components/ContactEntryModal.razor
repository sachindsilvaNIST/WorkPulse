@using WorkPulse.Models

<div class="modal-overlay">
    <div class="modal-panel max-w-2xl">
        <div class="modal-header">
            <h5 class="text-lg font-semibold text-app-fg">@(IsEdit ? "Edit Contact" : "Add Contact")</h5>
            <button class="text-app-fg-secondary hover:text-app-fg text-xl" @onclick="OnCancel">&times;</button>
        </div>
        <div class="modal-body">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-app-fg-secondary mb-1">Affiliation</label>
                    <AutocompleteInput @bind-Value="_affiliation" Suggestions="AffiliationSuggestions" Placeholder="e.g., Company" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-app-fg-secondary mb-1">Department</label>
                    <AutocompleteInput @bind-Value="_department" Suggestions="DepartmentSuggestions" Placeholder="e.g., Engineering" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-app-fg-secondary mb-1">Family Name *</label>
                    <input type="text" class="nist-input" @bind="_familyName" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-app-fg-secondary mb-1">Given Name</label>
                    <input type="text" class="nist-input" @bind="_givenName" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-app-fg-secondary mb-1">Email</label>
                    <input type="email" class="nist-input" @bind="_email" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-app-fg-secondary mb-1">Intercom</label>
                    <input type="text" class="nist-input" @bind="_intercom" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-app-fg-secondary mb-1">Contact Number</label>
                    <input type="text" class="nist-input" @bind="_contactNumber" />
                </div>
                <div class="col-span-2">
                    <label class="block text-sm font-medium text-app-fg-secondary mb-1">Notes</label>
                    <textarea class="nist-input" rows="2" @bind="_notes"></textarea>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="bg-red-50 border border-red-200 text-nist-danger px-4 py-3 rounded-md mt-4">@_error</div>
            }
        </div>
        <div class="modal-footer">
            <button class="btn-outline" @onclick="OnCancel">Cancel</button>
            <button class="btn-primary" @onclick="Save">Save</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public ContactRecord? Contact { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public List<ContactRecord> ExistingContacts { get; set; } = new();
    [Parameter] public EventCallback<ContactRecord> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private List<string> AffiliationSuggestions => ExistingContacts
        .Select(c => c.Affiliation).Where(a => !string.IsNullOrWhiteSpace(a))
        .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(a => a).ToList();

    private List<string> DepartmentSuggestions => ExistingContacts
        .Select(c => c.Department).Where(d => !string.IsNullOrWhiteSpace(d))
        .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(d => d).ToList();

    private string _affiliation = "";
    private string _familyName = "";
    private string _givenName = "";
    private string _department = "";
    private string _email = "";
    private string _intercom = "";
    private string _contactNumber = "";
    private string _notes = "";
    private string? _error;

    private bool _initialized;

    protected override void OnParametersSet()
    {
        if (_initialized) return;
        _initialized = true;

        if (Contact != null)
        {
            _affiliation = Contact.Affiliation;
            _familyName = Contact.FamilyName;
            _givenName = Contact.GivenName;
            _department = Contact.Department;
            _email = Contact.Email;
            _intercom = Contact.Intercom;
            _contactNumber = Contact.ContactNumber;
            _notes = Contact.Notes;
        }
    }

    private async Task Save()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_familyName))
        {
            _error = "Family Name is required.";
            return;
        }

        var record = new ContactRecord
        {
            Affiliation = _affiliation.Trim(),
            FamilyName = _familyName.Trim(),
            GivenName = _givenName.Trim(),
            Department = _department.Trim(),
            Email = _email.Trim(),
            Intercom = _intercom.Trim(),
            ContactNumber = _contactNumber.Trim(),
            Notes = _notes.Trim()
        };

        await OnSave.InvokeAsync(record);
    }
}
