@using WorkPulse.Web.Services
@inject ApiDictionaryService DictService

<div class="modal-overlay">
    <div class="modal-panel max-w-lg">
        <div class="modal-header">
            <h5 class="text-lg font-semibold text-app-fg">Manage Labels</h5>
            <button class="text-app-fg-secondary hover:text-app-fg text-xl" @onclick="OnClose">&times;</button>
        </div>
        <div class="modal-body">
            <!-- Add new label -->
            <div class="flex gap-2 mb-4">
                <input type="text" class="nist-input flex-1" @bind="_newLabelName" placeholder="New label name..." />
                <input type="color" class="w-10 h-10 rounded border border-app-divider cursor-pointer p-0.5" @bind="_newLabelColor" />
                <button class="btn-primary" @onclick="AddLabel" disabled="@string.IsNullOrWhiteSpace(_newLabelName)">Add</button>
            </div>

            <!-- Label list -->
            @if (!Labels.Any())
            {
                <p class="text-center text-app-fg-secondary py-6">No labels yet. Create your first label above.</p>
            }
            else
            {
                <div class="flex flex-col gap-2">
                    @foreach (var label in Labels)
                    {
                        <div class="flex items-center gap-2 px-3 py-2 rounded border border-app-divider">
                            @if (_editingLabelId == label.Id)
                            {
                                <input type="color" class="w-8 h-8 rounded border-0 cursor-pointer p-0" @bind="_editColor" />
                                <input type="text" class="nist-input flex-1" @bind="_editName" />
                                <button class="btn-primary text-xs !px-2 !py-1" @onclick="SaveEditLabel">Save</button>
                                <button class="btn-outline text-xs !px-2 !py-1" @onclick="() => _editingLabelId = 0">Cancel</button>
                            }
                            else
                            {
                                <span class="w-4 h-4 rounded-full shrink-0" style="background-color: @label.Color"></span>
                                <span class="flex-1 text-app-fg font-medium">@label.Name</span>
                                <span class="text-xs text-app-fg-secondary">@label.EntryCount entries</span>
                                <button class="btn-outline text-xs !px-2 !py-1" @onclick="() => StartEditLabel(label)">Edit</button>
                                <button class="btn-danger text-xs !px-2 !py-1" @onclick="() => DeleteLabel(label)">Del</button>
                            }
                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="bg-red-50 border border-red-200 text-nist-danger px-4 py-3 rounded-md mt-4">@_error</div>
            }
        </div>
        <div class="modal-footer">
            <button class="btn-outline" @onclick="OnClose">Close</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public List<DictLabelDto> Labels { get; set; } = new();
    [Parameter] public EventCallback OnClose { get; set; }

    private string _newLabelName = "";
    private string _newLabelColor = "#0078D4";
    private string? _error;

    private int _editingLabelId;
    private string _editName = "";
    private string _editColor = "";

    private async Task AddLabel()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_newLabelName)) return;

        var result = await DictService.CreateLabelAsync(new DictLabelCreateDto
        {
            Name = _newLabelName.Trim(),
            Color = _newLabelColor
        });

        if (result != null)
        {
            Labels.Add(result);
            _newLabelName = "";
            _newLabelColor = "#0078D4";
        }
        else
        {
            _error = "Failed to create label. Name may already exist.";
        }
    }

    private void StartEditLabel(DictLabelDto label)
    {
        _editingLabelId = label.Id;
        _editName = label.Name;
        _editColor = label.Color;
    }

    private async Task SaveEditLabel()
    {
        _error = null;
        var label = Labels.FirstOrDefault(l => l.Id == _editingLabelId);
        if (label == null) return;

        await DictService.UpdateLabelAsync(label.Id, new DictLabelCreateDto
        {
            Name = _editName.Trim(),
            Color = _editColor
        });

        label.Name = _editName.Trim();
        label.Color = _editColor;
        _editingLabelId = 0;
    }

    private async Task DeleteLabel(DictLabelDto label)
    {
        await DictService.DeleteLabelAsync(label.Id);
        Labels.Remove(label);
    }
}
