@using WorkPulse.Models
@using WorkPulse.Services
@inject IDataService DataService
@inject NavigationManager Nav

<!-- Bell button -->
<button class="relative p-1 text-white/70 hover:text-white transition-colors" @onclick="TogglePanel">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
    </svg>
    @if (_unreadCount > 0)
    {
        <span class="absolute -top-1 -right-1 w-4 h-4 bg-nist-danger text-white text-[10px] font-bold rounded-full flex items-center justify-center">
            @(_unreadCount > 9 ? "9+" : _unreadCount.ToString())
        </span>
    }
</button>

<!-- Full-screen overlay notification panel -->
@if (_showPanel)
{
    <div class="fixed inset-0 bg-black/50 z-50" @onclick="() => _showPanel = false"></div>
    <div class="fixed z-50 bg-app-bg rounded-lg shadow-xl border border-app-divider overflow-hidden flex flex-col
                inset-x-3 top-14 bottom-20
                sm:inset-auto sm:left-60 sm:top-4 sm:w-80 sm:max-h-[28rem]">
        <div class="px-4 py-3 border-b border-app-divider flex justify-between items-center shrink-0">
            <span class="text-sm font-semibold text-app-fg">Notifications</span>
            <div class="flex items-center gap-3">
                @if (_notifications.Any())
                {
                    <button class="text-xs text-nist-primary hover:underline" @onclick="ClearAll">Clear all</button>
                }
                <button class="text-app-fg-secondary hover:text-app-fg text-lg" @onclick="() => _showPanel = false">&times;</button>
            </div>
        </div>
        <div class="overflow-y-auto flex-1">
            @if (!_notifications.Any())
            {
                <div class="px-4 py-8 text-center text-app-fg-secondary text-sm">No notifications</div>
            }
            else
            {
                @foreach (var n in _notifications)
                {
                    <div class="px-4 py-3 border-b border-app-divider hover:bg-app-bg-alt transition-colors cursor-pointer @(n.Read ? "opacity-60" : "")"
                         @onclick="() => HandleNotificationClick(n)">
                        <div class="flex gap-2">
                            <div class="shrink-0 mt-0.5">
                                <span class="inline-block w-2 h-2 rounded-full @(n.Read ? "bg-transparent" : "bg-nist-primary")"></span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="text-sm font-medium text-app-fg">@n.Title</div>
                                <div class="text-xs text-app-fg-secondary mt-0.5">@n.Message</div>
                                <div class="text-[10px] text-app-fg-secondary mt-1">@FormatTime(n.CreatedAt)</div>
                            </div>
                            <span class="@GetTypeIconClass(n.Type) shrink-0">
                                @GetTypeIcon(n.Type)
                            </span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

@implements IDisposable

@code {
    [Parameter] public EventCallback OnNavigated { get; set; }

    private bool _showPanel;
    private List<AppNotification> _notifications = new();
    private int _unreadCount;
    private System.Threading.Timer? _checkTimer;

    protected override async Task OnInitializedAsync()
    {
        await CheckNotifications();

        // Check every 30 seconds
        _checkTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await CheckNotifications();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    public void Dispose()
    {
        _checkTimer?.Dispose();
    }

    private void TogglePanel()
    {
        _showPanel = !_showPanel;
    }

    private async Task CheckNotifications()
    {
        _notifications.Clear();

        try
        {
            var now = DateTime.Now;
            var today = DateOnly.FromDateTime(now);
            var monthData = await DataService.LoadMonthAsync(now.Year, now.Month);

            if (monthData != null)
            {
                // Check for missing today's entry
                var todayRecord = monthData.Records.FirstOrDefault(r => r.Date == today);
                if (todayRecord == null && now.DayOfWeek is not (DayOfWeek.Saturday or DayOfWeek.Sunday) && now.Hour >= 9)
                {
                    _notifications.Add(new AppNotification
                    {
                        Title = "Missing attendance",
                        Message = $"No entry for today ({today:MMM d}). Don't forget to log your attendance!",
                        Type = NotificationType.Warning,
                        Link = "/dashboard",
                        CreatedAt = now
                    });
                }

                // Check for undecided overtime
                var pendingOT = monthData.Records
                    .Where(r => r.DayType == DayType.WorkDay && r.LoginTime.HasValue && r.LogoutTime.HasValue && !r.IsOvertimeDecided)
                    .ToList();
                if (pendingOT.Any())
                {
                    _notifications.Add(new AppNotification
                    {
                        Title = "Overtime pending",
                        Message = $"{pendingOT.Count} day(s) need overtime decision this month.",
                        Type = NotificationType.Info,
                        Link = "/dashboard",
                        CreatedAt = now.AddMinutes(-1)
                    });
                }

                // Monthly summary (after 25th)
                if (now.Day >= 25)
                {
                    var workDays = monthData.TotalWorkDays;
                    var otCount = monthData.OvertimeCount;
                    _notifications.Add(new AppNotification
                    {
                        Title = "Monthly summary",
                        Message = $"{now:MMMM}: {workDays} work days, {otCount} overtime entries.",
                        Type = NotificationType.Success,
                        Link = "/calendar",
                        CreatedAt = now.AddMinutes(-2)
                    });
                }
            }
            else if (now.DayOfWeek is not (DayOfWeek.Saturday or DayOfWeek.Sunday))
            {
                _notifications.Add(new AppNotification
                {
                    Title = "No data this month",
                    Message = $"Start tracking your attendance for {now:MMMM}.",
                    Type = NotificationType.Info,
                    Link = "/dashboard",
                    CreatedAt = now
                });
            }
        }
        catch { }

        _unreadCount = _notifications.Count(n => !n.Read);
    }

    private void HandleNotificationClick(AppNotification n)
    {
        n.Read = true;
        _unreadCount = _notifications.Count(x => !x.Read);
        _showPanel = false;
        if (!string.IsNullOrEmpty(n.Link))
            Nav.NavigateTo(n.Link);
    }

    private void ClearAll()
    {
        _notifications.Clear();
        _unreadCount = 0;
        _showPanel = false;
    }

    private static string FormatTime(DateTime dt)
    {
        var diff = DateTime.Now - dt;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return dt.ToString("MMM d");
    }

    private static string GetTypeIconClass(NotificationType type) => type switch
    {
        NotificationType.Warning => "text-amber-500 text-sm",
        NotificationType.Info => "text-nist-primary text-sm",
        NotificationType.Success => "text-nist-success text-sm",
        _ => "text-app-fg-secondary text-sm"
    };

    private static string GetTypeIcon(NotificationType type) => type switch
    {
        NotificationType.Warning => "!",
        NotificationType.Info => "i",
        NotificationType.Success => "✓",
        _ => "•"
    };

    private class AppNotification
    {
        public string Title { get; set; } = "";
        public string Message { get; set; } = "";
        public NotificationType Type { get; set; }
        public string? Link { get; set; }
        public DateTime CreatedAt { get; set; }
        public bool Read { get; set; }
    }

    private enum NotificationType { Info, Warning, Success }
}
