@inject WorkPulse.Web.Services.ToastService Toast
@implements IDisposable

@if (Toast.Messages.Any())
{
    <div class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 max-w-sm">
        @foreach (var msg in Toast.Messages)
        {
            <div class="flex items-start gap-3 px-4 py-3 rounded-lg shadow-lg border text-sm animate-slide-in @LevelClass(msg.Level)">
                <span class="mt-0.5">@LevelIcon(msg.Level)</span>
                <span class="flex-1">@msg.Text</span>
                <button class="text-current opacity-60 hover:opacity-100 text-lg leading-none" @onclick="() => Dismiss(msg.Id)">&times;</button>
            </div>
        }
    </div>
}

@code {
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        Toast.OnChange += StateHasChanged;
        _timer = new System.Threading.Timer(_ => InvokeAsync(CleanOld), null, 1000, 1000);
    }

    private void CleanOld()
    {
        var cutoff = DateTime.UtcNow.AddSeconds(-4);
        var stale = Toast.Messages.Where(m => m.CreatedUtc < cutoff).ToList();
        foreach (var m in stale)
            Toast.Remove(m.Id);
    }

    private void Dismiss(string id) => Toast.Remove(id);

    private static string LevelClass(WorkPulse.Web.Services.ToastLevel level) => level switch
    {
        WorkPulse.Web.Services.ToastLevel.Success => "bg-green-50 border-green-300 text-green-800",
        WorkPulse.Web.Services.ToastLevel.Error => "bg-red-50 border-red-300 text-red-800",
        WorkPulse.Web.Services.ToastLevel.Warning => "bg-yellow-50 border-yellow-300 text-yellow-800",
        _ => "bg-blue-50 border-blue-300 text-blue-800"
    };

    private static string LevelIcon(WorkPulse.Web.Services.ToastLevel level) => level switch
    {
        WorkPulse.Web.Services.ToastLevel.Success => "✓",
        WorkPulse.Web.Services.ToastLevel.Error => "✗",
        WorkPulse.Web.Services.ToastLevel.Warning => "⚠",
        _ => "ℹ"
    };

    public void Dispose()
    {
        Toast.OnChange -= StateHasChanged;
        _timer?.Dispose();
    }
}
