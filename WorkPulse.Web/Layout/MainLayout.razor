@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="flex h-[100dvh] relative">
    <!-- Mobile overlay -->
    @if (_sidebarOpen)
    {
        <div class="fixed inset-0 bg-black/50 z-30 md:hidden" @onclick="() => _sidebarOpen = false"></div>
    }

    <!-- Sidebar: slide-over on mobile, fixed on desktop -->
    <div class="@SidebarClass">
        <NavMenu OnNavigated="() => _sidebarOpen = false" />
    </div>

    <!-- Main content -->
    <div class="flex-1 flex flex-col overflow-hidden">
        <!-- Mobile top bar -->
        <div class="glass-topbar flex items-center gap-3 px-4 py-2 md:hidden">
            <button class="text-white p-1" @onclick="() => _sidebarOpen = !_sidebarOpen">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
            <span class="text-white font-semibold text-sm"><span class="text-nist-primary">Work</span>Pulse</span>
        </div>

        <main class="flex-1 overflow-auto p-4 sm:p-6">
            <div class="page-transition" @key="Nav.Uri">
                @Body
            </div>
        </main>
        <WorkPulse.Web.Components.ToastContainer />
        <WorkPulse.Web.Components.CommandPalette @ref="_palette" />
        <div class="px-4 py-2 bg-app-bg-alt border-t border-app-divider text-xs text-app-fg-secondary hidden sm:block">
            WorkPulse
        </div>
    </div>
</div>

@code {
    private bool _sidebarOpen;
    private WorkPulse.Web.Components.CommandPalette? _palette;
    private DotNetObjectReference<MainLayout>? _selfRef;

    private string SidebarClass => _sidebarOpen
        ? "fixed inset-y-0 left-0 z-40 w-56 transition-transform [transition-duration:350ms] [transition-timing-function:var(--ease-spring)] md:relative md:translate-x-0"
        : "fixed inset-y-0 left-0 z-40 w-56 -translate-x-full transition-transform [transition-duration:350ms] [transition-timing-function:var(--ease-spring)] md:relative md:translate-x-0";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerCommandPalette", _selfRef);
        }
    }

    [JSInvokable]
    public async Task TogglePalette()
    {
        if (_palette != null)
        {
            await _palette.Toggle();
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _selfRef?.Dispose();
    }
}
