@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthState
@inject WorkPulse.Web.Services.AuthService Auth
@inject WorkPulse.Web.Services.FeatureService Features
@inject NavigationManager Nav
@implements IDisposable

<nav class="glass-sidebar flex flex-col text-white p-4 w-56 h-[100dvh] overflow-y-auto">
    <div class="flex items-center justify-center gap-2 mb-6">
        <h5 class="text-lg font-semibold">
            <span class="text-nist-primary">Work</span>Pulse
        </h5>
        <AuthorizeView>
            <Authorized Context="bellContext">
                @if (_enabled.Contains("notifications"))
                {
                    <WorkPulse.Web.Components.NotificationBell />
                }
                @if (_enabled.Contains("quicklinks"))
                {
                    <button class="text-white/70 hover:text-white" title="Quick Links" @onclick="() => _showQuickLinks = true">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 010 5.656l-2 2a4 4 0 01-5.656-5.656l1-1m5.656-1l1-1a4 4 0 00-5.656-5.656l-2 2a4 4 0 000 5.656" /></svg>
                    </button>
                }
            </Authorized>
        </AuthorizeView>
    </div>

    <WorkPulse.Web.Components.QuickLinksPanel Show="_showQuickLinks" OnClose="() => _showQuickLinks = false" />

    <AuthorizeView>
        <Authorized>
            <ul class="flex flex-col gap-1">
                <li>
                    <NavLink class="nav-pill" href="" Match="NavLinkMatch.All">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1" /></svg>
                        Home
                    </NavLink>
                </li>
                <li>
                    <NavLink class="nav-pill" href="dashboard">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                        Attendance
                    </NavLink>
                </li>
                @if (_enabled.Contains("reports"))
                {
                    <li>
                        <NavLink class="nav-pill" href="reports/daily">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                            Reports
                        </NavLink>
                    </li>
                    <li>
                        <NavLink class="nav-pill" href="reports/trips">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" /></svg>
                            Business Trips
                        </NavLink>
                    </li>
                    <li>
                        <NavLink class="nav-pill" href="reimbursement">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h10M4 18h10" /></svg>
                            Reimbursement
                        </NavLink>
                    </li>
                }
                @if (_enabled.Contains("quicklinks"))
                {
                    <li>
                        <NavLink class="nav-pill" href="bookmarks">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" /></svg>
                            Bookmarks
                        </NavLink>
                    </li>
                }
                @if (_enabled.Contains("contacts"))
                {
                    <li>
                        <NavLink class="nav-pill" href="contacts">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                            Contacts
                        </NavLink>
                    </li>
                }
                @if (_enabled.Contains("dictionary"))
                {
                    <li>
                        <NavLink class="nav-pill" href="dictionary">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                            JP Dictionary
                        </NavLink>
                    </li>
                }
                <li>
                    <NavLink class="nav-pill" href="settings">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.573-1.066z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        Settings
                    </NavLink>
                </li>
            </ul>

            <AuthorizeView Roles="Admin">
                <Authorized Context="adminContext">
                    <div class="mt-4 pt-4 border-t border-white/20">
                        <ul class="flex flex-col gap-1">
                            <li>
                                <NavLink class="nav-pill" href="admin">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                                    Admin
                                </NavLink>
                            </li>
                        </ul>
                    </div>
                </Authorized>
            </AuthorizeView>

            <div class="mt-auto pt-4 pb-[env(safe-area-inset-bottom)] border-t border-white/20">
                <small class="text-white/50 block mb-2">@context.User.Identity?.Name</small>
                <button class="w-full px-3 py-1.5 text-sm border border-white/30 rounded-md text-white/70 hover:bg-white/10 transition-colors" @onclick="Logout">
                    Logout
                </button>
            </div>
        </Authorized>
        <NotAuthorized>
            <ul class="flex flex-col gap-1">
                <li>
                    <NavLink class="nav-pill" href="login">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" /></svg>
                        Login
                    </NavLink>
                </li>
                <li>
                    <NavLink class="nav-pill" href="register">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" /></svg>
                        Register
                    </NavLink>
                </li>
            </ul>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    [Parameter] public EventCallback OnNavigated { get; set; }

    private HashSet<string> _enabled = new(WorkPulse.Web.Services.FeatureService.Catalog, StringComparer.OrdinalIgnoreCase);
    private bool _showQuickLinks;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += HandleLocationChanged;
        await RefreshEnabledAsync();
        if (AuthState is WorkPulse.Web.Services.JwtAuthStateProvider jasp)
        {
            jasp.AuthenticationStateChanged += async _ =>
            {
                await RefreshEnabledAsync();
                await InvokeAsync(StateHasChanged);
            };
        }
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        OnNavigated.InvokeAsync();
    }

    private async Task RefreshEnabledAsync()
    {
        var disabled = await Features.GetDisabledAsync();
        _enabled = WorkPulse.Web.Services.FeatureService.Catalog
            .Where(f => !disabled.Contains(f))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= HandleLocationChanged;
    }

    private async Task Logout()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("login");
    }
}
