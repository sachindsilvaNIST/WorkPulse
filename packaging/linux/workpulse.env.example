# Copy this to /opt/workpulse/workpulse.env on the server (chmod 600, owned by the
# workpulse user) and fill in real values. NEVER commit the real file to git.
#
# Note the double-underscore in Jwt__Secret — ASP.NET Core maps "Jwt__Secret" as an
# environment variable to the "Jwt:Secret" config key. Colons aren't valid in env var
# names on Linux, so this is the required syntax (same idea as Cloud Run's "Jwt:Secret"
# variable, just written differently here).

DATABASE_URL=postgresql://neondb_owner:REPLACE_ME@ep-wandering-sound-a1k7elef-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
Jwt__Secret=REPLACE_ME_WITH_A_NEW_ROTATED_SECRET
Jwt__Issuer=WorkPulseApi
Jwt__Audience=WorkPulseApp
AllowedOrigins__0=https://your-domain-or-ip
