@using NistAttendance.Models

<div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-2xl mx-4">
        <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
            <h5 class="text-lg font-semibold">@(IsEdit ? "Edit Contact" : "Add Contact")</h5>
            <button class="text-gray-400 hover:text-gray-600 text-xl" @onclick="OnCancel">&times;</button>
        </div>
        <div class="px-6 py-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Affiliation</label>
                    <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-nist-primary/40" @bind="_affiliation" placeholder="e.g., NIST" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Department</label>
                    <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-nist-primary/40" @bind="_department" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Family Name *</label>
                    <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-nist-primary/40" @bind="_familyName" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Given Name</label>
                    <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-nist-primary/40" @bind="_givenName" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                    <input type="email" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-nist-primary/40" @bind="_email" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Intercom</label>
                    <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-nist-primary/40" @bind="_intercom" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Contact Number</label>
                    <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-nist-primary/40" @bind="_contactNumber" />
                </div>
                <div class="col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
                    <textarea class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-nist-primary/40" rows="2" @bind="_notes"></textarea>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-md mt-4">@_error</div>
            }
        </div>
        <div class="px-6 py-4 border-t border-gray-200 flex justify-end gap-2">
            <button class="px-4 py-2 border border-gray-300 rounded-md text-sm hover:bg-gray-100 transition-colors" @onclick="OnCancel">Cancel</button>
            <button class="px-4 py-2 bg-nist-primary hover:bg-nist-primary-dark text-white rounded-md text-sm transition-colors" @onclick="Save">Save</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public ContactRecord? Contact { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public EventCallback<ContactRecord> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string _affiliation = "";
    private string _familyName = "";
    private string _givenName = "";
    private string _department = "";
    private string _email = "";
    private string _intercom = "";
    private string _contactNumber = "";
    private string _notes = "";
    private string? _error;

    protected override void OnParametersSet()
    {
        if (Contact != null)
        {
            _affiliation = Contact.Affiliation;
            _familyName = Contact.FamilyName;
            _givenName = Contact.GivenName;
            _department = Contact.Department;
            _email = Contact.Email;
            _intercom = Contact.Intercom;
            _contactNumber = Contact.ContactNumber;
            _notes = Contact.Notes;
        }
    }

    private async Task Save()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_familyName))
        {
            _error = "Family Name is required.";
            return;
        }

        var record = new ContactRecord
        {
            Affiliation = _affiliation.Trim(),
            FamilyName = _familyName.Trim(),
            GivenName = _givenName.Trim(),
            Department = _department.Trim(),
            Email = _email.Trim(),
            Intercom = _intercom.Trim(),
            ContactNumber = _contactNumber.Trim(),
            Notes = _notes.Trim()
        };

        await OnSave.InvokeAsync(record);
    }
}
