@page "/login"
@inject NistAttendance.Web.Services.AuthService Auth
@inject NavigationManager Nav

<div class="flex justify-center mt-16">
    <div class="w-full max-w-sm">
        <div class="bg-white rounded-lg shadow-lg p-6">
            <h3 class="text-center text-xl font-semibold mb-6">Login</h3>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-md mb-4">@_error</div>
            }

            <EditForm Model="_model" OnValidSubmit="HandleLogin">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                    <InputText class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-nist-primary/40 focus:border-nist-primary" @bind-Value="_model.Email" placeholder="you@example.com" />
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                    <InputText class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-nist-primary/40 focus:border-nist-primary" type="password" @bind-Value="_model.Password" />
                </div>
                <button type="submit" class="w-full bg-nist-primary hover:bg-nist-primary-dark text-white font-medium py-2 px-4 rounded-md transition-colors disabled:opacity-50" disabled="@_loading">
                    @if (_loading) { <span class="inline-block w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin mr-2 align-middle"></span> }
                    Login
                </button>
            </EditForm>

            <p class="text-center mt-4 text-sm text-gray-500">
                Don't have an account? <a href="register" class="text-nist-primary hover:underline">Register</a>
            </p>
        </div>
    </div>
</div>

@code {
    private LoginModel _model = new();
    private string? _error;
    private bool _loading;

    private async Task HandleLogin()
    {
        _loading = true;
        _error = null;
        var (success, error) = await Auth.LoginAsync(_model.Email, _model.Password);
        if (success)
            Nav.NavigateTo("/");
        else
            _error = "Invalid email or password.";
        _loading = false;
    }

    private class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
