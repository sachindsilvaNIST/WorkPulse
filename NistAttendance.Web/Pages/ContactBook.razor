@page "/contacts"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using NistAttendance.Models
@inject NistAttendance.Web.Services.ApiContactDataService ContactService

<div class="flex justify-between items-center mb-4">
    <h4 class="text-xl font-semibold">Contact Book</h4>
    <div class="flex gap-2">
        <input type="text" class="w-64 px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-nist-primary/40 focus:border-nist-primary" placeholder="Search contacts..."
               @bind="_searchText" @bind:event="oninput" @bind:after="ApplyFilter" />
        <button class="bg-nist-primary hover:bg-nist-primary-dark text-white font-medium py-2 px-4 rounded-md text-sm transition-colors" @onclick="AddContact">
            + Add
        </button>
        <button class="border border-gray-300 text-gray-700 hover:bg-gray-100 font-medium py-2 px-4 rounded-md text-sm transition-colors disabled:opacity-50" @onclick="ExportContacts" disabled="@_exporting">
            Export
        </button>
    </div>
</div>

@if (_loading)
{
    <div class="text-center py-12">
        <div class="inline-block w-8 h-8 border-4 border-nist-primary/30 border-t-nist-primary rounded-full animate-spin"></div>
    </div>
}
else
{
    <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
            <thead>
                <tr class="bg-gray-900 text-white">
                    <th class="px-3 py-2 text-left text-xs uppercase tracking-wide">Affiliation</th>
                    <th class="px-3 py-2 text-left text-xs uppercase tracking-wide">Family Name</th>
                    <th class="px-3 py-2 text-left text-xs uppercase tracking-wide">Given Name</th>
                    <th class="px-3 py-2 text-left text-xs uppercase tracking-wide">Department</th>
                    <th class="px-3 py-2 text-left text-xs uppercase tracking-wide">Email</th>
                    <th class="px-3 py-2 text-left text-xs uppercase tracking-wide">Intercom</th>
                    <th class="px-3 py-2 text-left text-xs uppercase tracking-wide">Contact Number</th>
                    <th class="px-3 py-2 text-left text-xs uppercase tracking-wide">Notes</th>
                    <th class="px-3 py-2 text-left text-xs uppercase tracking-wide w-24">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!_filtered.Any())
                {
                    <tr><td colspan="9" class="text-center text-gray-400 py-8">No contacts found.</td></tr>
                }
                @foreach (var c in _filtered)
                {
                    <tr class="border-b border-gray-200 hover:bg-gray-50">
                        <td class="px-3 py-2">@c.Affiliation</td>
                        <td class="px-3 py-2">@c.FamilyName</td>
                        <td class="px-3 py-2">@c.GivenName</td>
                        <td class="px-3 py-2">@c.Department</td>
                        <td class="px-3 py-2">@c.Email</td>
                        <td class="px-3 py-2">@c.Intercom</td>
                        <td class="px-3 py-2">@c.ContactNumber</td>
                        <td class="px-3 py-2">@c.Notes</td>
                        <td class="px-3 py-2 flex gap-1">
                            <button class="px-2 py-1 text-xs border border-nist-primary text-nist-primary rounded hover:bg-nist-primary hover:text-white transition-colors" @onclick="() => EditContact(c)">
                                Edit
                            </button>
                            <button class="px-2 py-1 text-xs border border-red-500 text-red-500 rounded hover:bg-red-500 hover:text-white transition-colors" @onclick="() => DeleteContact(c)">
                                Del
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <small class="text-gray-400 mt-2 block">@_filtered.Count of @_contacts.Count contacts</small>
}

@if (_showModal)
{
    <ContactEntryModal Contact="@_editingContact" IsEdit="@_isEdit"
                       OnSave="HandleSave" OnCancel="CloseModal" />
}

@if (_showDeleteConfirm)
{
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-md">
            <div class="px-6 py-4 border-b border-gray-200">
                <h5 class="text-lg font-semibold">Delete Contact</h5>
            </div>
            <div class="px-6 py-4">
                Are you sure you want to delete <strong>@_deletingContact?.FullName</strong>?
            </div>
            <div class="px-6 py-4 border-t border-gray-200 flex justify-end gap-2">
                <button class="px-4 py-2 border border-gray-300 rounded-md text-sm hover:bg-gray-100 transition-colors" @onclick="() => _showDeleteConfirm = false">Cancel</button>
                <button class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-md text-sm transition-colors" @onclick="ConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
}

@implements IDisposable

@code {
    private List<ContactRecord> _contacts = new();
    private List<ContactRecord> _filtered = new();
    private string _searchText = "";
    private bool _loading = true;
    private bool _exporting;

    private bool _showModal;
    private bool _isEdit;
    private ContactRecord? _editingContact;

    private bool _showDeleteConfirm;
    private ContactRecord? _deletingContact;
    private System.Threading.Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadContacts();

        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                var data = await ContactService.LoadContactsAsync();
                _contacts = data.Contacts;
                ApplyFilter();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }

    private async Task LoadContacts()
    {
        _loading = true;
        var data = await ContactService.LoadContactsAsync();
        _contacts = data.Contacts;
        ApplyFilter();
        _loading = false;
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(_searchText))
            _filtered = _contacts.ToList();
        else
        {
            var q = _searchText.ToLowerInvariant();
            _filtered = _contacts.Where(c => c.SearchText.Contains(q)).ToList();
        }
    }

    private void AddContact()
    {
        _editingContact = null;
        _isEdit = false;
        _showModal = true;
    }

    private void EditContact(ContactRecord c)
    {
        _editingContact = c;
        _isEdit = true;
        _showModal = true;
    }

    private async Task HandleSave(ContactRecord contact)
    {
        if (_isEdit && _editingContact != null)
        {
            var idx = _contacts.FindIndex(c => c.Id == _editingContact.Id);
            if (idx >= 0)
            {
                contact.Id = _editingContact.Id;
                _contacts[idx] = contact;
            }
        }
        else
        {
            _contacts.Add(contact);
        }

        await ContactService.SaveContactsAsync(new ContactBookData { Contacts = _contacts });
        ApplyFilter();
        _showModal = false;
    }

    private void CloseModal() => _showModal = false;

    private void DeleteContact(ContactRecord c)
    {
        _deletingContact = c;
        _showDeleteConfirm = true;
    }

    private async Task ConfirmDelete()
    {
        if (_deletingContact != null)
        {
            _contacts.RemoveAll(c => c.Id == _deletingContact.Id);
            await ContactService.SaveContactsAsync(new ContactBookData { Contacts = _contacts });
            ApplyFilter();
        }
        _showDeleteConfirm = false;
    }

    private Task ExportContacts()
    {
        _exporting = true;
        // TODO: call Excel export API endpoint and trigger download
        _exporting = false;
        return Task.CompletedTask;
    }
}
