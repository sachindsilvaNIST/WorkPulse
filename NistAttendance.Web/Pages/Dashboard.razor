@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@using NistAttendance.Models
@using NistAttendance.Services
@attribute [Authorize]
@inject IDataService DataService

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Attendance Dashboard</h3>
    <button class="btn btn-primary" @onclick="ShowAddEntry">+ Add Entry</button>
</div>

<!-- Month Navigator -->
<div class="d-flex align-items-center gap-3 mb-4">
    <button class="btn btn-outline-secondary btn-sm" @onclick="PrevMonth">&lt;</button>
    <h5 class="mb-0">@_monthLabel @_year</h5>
    <button class="btn btn-outline-secondary btn-sm" @onclick="NextMonth">&gt;</button>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-auto">
        <div class="card border-primary">
            <div class="card-body py-2 px-3">
                <small class="text-secondary">Work Days</small>
                <h5 class="mb-0 text-primary">@(_monthData?.TotalWorkDays ?? 0)</h5>
            </div>
        </div>
    </div>
    <div class="col-auto">
        <div class="card border-warning">
            <div class="card-body py-2 px-3">
                <small class="text-secondary">Overtime</small>
                <h5 class="mb-0 text-warning">@(_monthData?.OvertimeCount ?? 0)</h5>
            </div>
        </div>
    </div>
    <div class="col-auto">
        <div class="card border-info">
            <div class="card-body py-2 px-3">
                <small class="text-secondary">Total OT</small>
                @{ var (h, m) = _monthData?.TotalOvertimeDuration ?? (0, 0); }
                <h5 class="mb-0 text-info">@h Hr @m Min</h5>
            </div>
        </div>
    </div>
</div>

<!-- Search -->
<div class="mb-3">
    <input type="text" class="form-control" placeholder="Search records..." @bind="_searchText" @bind:event="oninput" />
</div>

<!-- Attendance Table -->
<div class="table-responsive">
    <table class="table table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Day</th>
                <th>Date</th>
                <th>Login</th>
                <th>Logout</th>
                <th>Overtime</th>
                <th>OT Flag</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var record in FilteredRecords)
            {
                <tr class="@GetRowClass(record)">
                    <td>@record.DayAbbreviation</td>
                    <td>@record.Date.ToString("yyyy-MM-dd")</td>
                    <td>@record.LoginDisplay</td>
                    <td>@record.LogoutDisplay</td>
                    <td>
                        @if (record.IsOvertime)
                        {
                            <span>@record.OvertimeHours Hr @record.OvertimeMinutes Min</span>
                        }
                    </td>
                    <td>
                        @if (record.IsOvertimeDecided)
                        {
                            <span class="badge @(record.IsOvertime ? "bg-success" : "bg-danger")">
                                @(record.IsOvertime ? "YES" : "NO")
                            </span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-outline-primary btn-sm" @onclick="() => ShowEditEntry(record)">Edit</button>
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteRecord(record)">Del</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (_showEntryModal)
{
    <NistAttendance.Web.Components.AttendanceEntryModal
        Record="_editRecord"
        IsEdit="_isEdit"
        OnSave="HandleEntrySave"
        OnCancel="() => _showEntryModal = false" />
}

@implements IDisposable

@code {
    private int _year = DateTime.Now.Year;
    private int _month = DateTime.Now.Month;
    private string _monthLabel = "";
    private MonthlyData? _monthData;
    private string _searchText = "";
    private bool _showEntryModal;
    private AttendanceRecord? _editRecord;
    private bool _isEdit;
    private System.Threading.Timer? _refreshTimer;

    private IEnumerable<AttendanceRecord> FilteredRecords =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _monthData?.Records ?? Enumerable.Empty<AttendanceRecord>()
            : (_monthData?.Records ?? Enumerable.Empty<AttendanceRecord>())
                .Where(r => r.SearchText.Contains(_searchText.ToLowerInvariant()));

    protected override async Task OnInitializedAsync()
    {
        await LoadMonth();

        // Auto-refresh every 30 seconds to pick up desktop-synced changes
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadMonth();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }

    private async Task LoadMonth()
    {
        _monthLabel = new DateTime(_year, _month, 1).ToString("MMMM");
        _monthData = await DataService.LoadMonthAsync(_year, _month);
        _monthData ??= new MonthlyData { Year = _year, Month = _month, MonthLabel = _monthLabel.Substring(0, 3).ToUpper() };
    }

    private async Task PrevMonth()
    {
        _month--;
        if (_month < 1) { _month = 12; _year--; }
        await LoadMonth();
    }

    private async Task NextMonth()
    {
        _month++;
        if (_month > 12) { _month = 1; _year++; }
        await LoadMonth();
    }

    private void ShowAddEntry()
    {
        _editRecord = new AttendanceRecord { Date = new DateOnly(_year, _month, DateTime.Now.Day) };
        _isEdit = false;
        _showEntryModal = true;
    }

    private void ShowEditEntry(AttendanceRecord record)
    {
        _editRecord = record;
        _isEdit = true;
        _showEntryModal = true;
    }

    private async Task HandleEntrySave(AttendanceRecord record)
    {
        _showEntryModal = false;
        if (_monthData == null) return;

        var existing = _monthData.Records.FirstOrDefault(r => r.Date == record.Date);
        if (existing != null)
            _monthData.Records.Remove(existing);
        _monthData.Records.Add(record);
        _monthData.Records = _monthData.Records.OrderBy(r => r.Date).ToList();

        await DataService.SaveMonthAsync(_monthData);
        await LoadMonth();
    }

    private async Task DeleteRecord(AttendanceRecord record)
    {
        if (_monthData == null) return;
        _monthData.Records.Remove(record);
        await DataService.SaveMonthAsync(_monthData);
        await LoadMonth();
    }

    private string GetRowClass(AttendanceRecord record) => record.DayType switch
    {
        DayType.Weekend => "table-secondary",
        DayType.AnnualPaidLeave or DayType.UnpaidLeave => "table-warning",
        DayType.PublicHoliday => "table-info",
        DayType.BusinessTrip => "table-primary",
        _ => ""
    };
}
