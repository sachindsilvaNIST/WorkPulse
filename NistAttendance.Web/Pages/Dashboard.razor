@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@using NistAttendance.Models
@using NistAttendance.Services
@attribute [Authorize]
@inject IDataService DataService

<div class="flex justify-between items-center mb-4">
    <h3 class="text-xl font-semibold">Attendance Dashboard</h3>
    <button class="bg-nist-primary hover:bg-nist-primary-dark text-white font-medium py-2 px-4 rounded-md transition-colors" @onclick="ShowAddEntry">+ Add Entry</button>
</div>

<!-- Month Navigator -->
<div class="flex items-center gap-3 mb-6">
    <button class="px-3 py-1 border border-gray-300 rounded-md text-sm hover:bg-gray-100 transition-colors" @onclick="PrevMonth">&lt;</button>
    <h5 class="text-lg font-medium">@_monthLabel @_year</h5>
    <button class="px-3 py-1 border border-gray-300 rounded-md text-sm hover:bg-gray-100 transition-colors" @onclick="NextMonth">&gt;</button>
</div>

<!-- Summary Cards -->
<div class="flex gap-4 mb-6">
    <div class="bg-white border-2 border-nist-primary rounded-lg px-4 py-2">
        <small class="text-xs text-gray-500 uppercase">Work Days</small>
        <h5 class="text-lg font-bold text-nist-primary">@(_monthData?.TotalWorkDays ?? 0)</h5>
    </div>
    <div class="bg-white border-2 border-amber-400 rounded-lg px-4 py-2">
        <small class="text-xs text-gray-500 uppercase">Overtime</small>
        <h5 class="text-lg font-bold text-amber-500">@(_monthData?.OvertimeCount ?? 0)</h5>
    </div>
    <div class="bg-white border-2 border-cyan-400 rounded-lg px-4 py-2">
        <small class="text-xs text-gray-500 uppercase">Total OT</small>
        @{ var (h, m) = _monthData?.TotalOvertimeDuration ?? (0, 0); }
        <h5 class="text-lg font-bold text-cyan-500">@h Hr @m Min</h5>
    </div>
</div>

<!-- Search -->
<div class="mb-4">
    <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-nist-primary/40 focus:border-nist-primary" placeholder="Search records..." @bind="_searchText" @bind:event="oninput" />
</div>

<!-- Attendance Table -->
<div class="overflow-x-auto">
    <table class="w-full text-sm border-collapse">
        <thead>
            <tr class="bg-gray-900 text-white">
                <th class="px-3 py-2 text-left text-xs uppercase tracking-wide">Day</th>
                <th class="px-3 py-2 text-left text-xs uppercase tracking-wide">Date</th>
                <th class="px-3 py-2 text-left text-xs uppercase tracking-wide">Login</th>
                <th class="px-3 py-2 text-left text-xs uppercase tracking-wide">Logout</th>
                <th class="px-3 py-2 text-left text-xs uppercase tracking-wide">Overtime</th>
                <th class="px-3 py-2 text-left text-xs uppercase tracking-wide">OT Flag</th>
                <th class="px-3 py-2 text-left text-xs uppercase tracking-wide">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var record in FilteredRecords)
            {
                <tr class="border-b border-gray-200 hover:bg-gray-50 @GetRowClass(record)">
                    <td class="px-3 py-2">@record.DayAbbreviation</td>
                    <td class="px-3 py-2">@record.Date.ToString("yyyy-MM-dd")</td>
                    <td class="px-3 py-2">@record.LoginDisplay</td>
                    <td class="px-3 py-2">@record.LogoutDisplay</td>
                    <td class="px-3 py-2">
                        @if (record.IsOvertime)
                        {
                            <span>@record.OvertimeHours Hr @record.OvertimeMinutes Min</span>
                        }
                    </td>
                    <td class="px-3 py-2">
                        @if (record.IsOvertimeDecided)
                        {
                            <span class="inline-block px-2 py-0.5 text-xs font-semibold rounded-full @(record.IsOvertime ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700")">
                                @(record.IsOvertime ? "YES" : "NO")
                            </span>
                        }
                    </td>
                    <td class="px-3 py-2 flex gap-1">
                        <button class="px-2 py-1 text-xs border border-nist-primary text-nist-primary rounded hover:bg-nist-primary hover:text-white transition-colors" @onclick="() => ShowEditEntry(record)">Edit</button>
                        <button class="px-2 py-1 text-xs border border-red-500 text-red-500 rounded hover:bg-red-500 hover:text-white transition-colors" @onclick="() => DeleteRecord(record)">Del</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (_showEntryModal)
{
    <NistAttendance.Web.Components.AttendanceEntryModal
        Record="_editRecord"
        IsEdit="_isEdit"
        OnSave="HandleEntrySave"
        OnCancel="() => _showEntryModal = false" />
}

@implements IDisposable

@code {
    private int _year = DateTime.Now.Year;
    private int _month = DateTime.Now.Month;
    private string _monthLabel = "";
    private MonthlyData? _monthData;
    private string _searchText = "";
    private bool _showEntryModal;
    private AttendanceRecord? _editRecord;
    private bool _isEdit;
    private System.Threading.Timer? _refreshTimer;

    private IEnumerable<AttendanceRecord> FilteredRecords =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _monthData?.Records ?? Enumerable.Empty<AttendanceRecord>()
            : (_monthData?.Records ?? Enumerable.Empty<AttendanceRecord>())
                .Where(r => r.SearchText.Contains(_searchText.ToLowerInvariant()));

    protected override async Task OnInitializedAsync()
    {
        await LoadMonth();

        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadMonth();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }

    private async Task LoadMonth()
    {
        _monthLabel = new DateTime(_year, _month, 1).ToString("MMMM");
        _monthData = await DataService.LoadMonthAsync(_year, _month);
        _monthData ??= new MonthlyData { Year = _year, Month = _month, MonthLabel = _monthLabel.Substring(0, 3).ToUpper() };
    }

    private async Task PrevMonth()
    {
        _month--;
        if (_month < 1) { _month = 12; _year--; }
        await LoadMonth();
    }

    private async Task NextMonth()
    {
        _month++;
        if (_month > 12) { _month = 1; _year++; }
        await LoadMonth();
    }

    private void ShowAddEntry()
    {
        _editRecord = new AttendanceRecord { Date = new DateOnly(_year, _month, DateTime.Now.Day) };
        _isEdit = false;
        _showEntryModal = true;
    }

    private void ShowEditEntry(AttendanceRecord record)
    {
        _editRecord = record;
        _isEdit = true;
        _showEntryModal = true;
    }

    private async Task HandleEntrySave(AttendanceRecord record)
    {
        _showEntryModal = false;
        if (_monthData == null) return;

        var existing = _monthData.Records.FirstOrDefault(r => r.Date == record.Date);
        if (existing != null)
            _monthData.Records.Remove(existing);
        _monthData.Records.Add(record);
        _monthData.Records = _monthData.Records.OrderBy(r => r.Date).ToList();

        await DataService.SaveMonthAsync(_monthData);
        await LoadMonth();
    }

    private async Task DeleteRecord(AttendanceRecord record)
    {
        if (_monthData == null) return;
        _monthData.Records.Remove(record);
        await DataService.SaveMonthAsync(_monthData);
        await LoadMonth();
    }

    private string GetRowClass(AttendanceRecord record) => record.DayType switch
    {
        DayType.Weekend => "row-weekend",
        DayType.AnnualPaidLeave or DayType.UnpaidLeave => "row-leave",
        DayType.PublicHoliday => "row-holiday",
        DayType.BusinessTrip => "row-trip",
        _ => ""
    };
}
