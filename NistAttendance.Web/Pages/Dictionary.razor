@page "/dictionary"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject NistAttendance.Web.Services.ApiDictionaryService DictService

<!-- Header -->
<div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-4">
    <div>
        <h3 class="text-xl font-semibold text-app-fg">JP / Jisho Dictionary</h3>
        <p class="text-sm text-app-fg-secondary">@_entries.Count words &middot; @_labels.Count labels</p>
    </div>
    <div class="flex flex-wrap gap-2">
        <button class="btn-primary" @onclick="ShowAddEntry">+ New</button>
        <button class="btn-info" @onclick="() => _showLabelManager = true">Labels</button>
    </div>
</div>

<!-- Search + Label Filter -->
<div class="flex flex-col sm:flex-row gap-3 mb-4">
    <input type="text" class="nist-input flex-1" placeholder="Search Japanese, reading, meaning..."
           @bind="_searchText" @bind:event="oninput" @bind:after="LoadEntries" />

    <select class="nist-input sm:w-48" @bind="_selectedLabelId" @bind:after="LoadEntries">
        <option value="0">All Labels</option>
        @foreach (var label in _labels)
        {
            <option value="@label.Id">@label.Name (@label.EntryCount)</option>
        }
    </select>
</div>

<!-- Entries -->
@if (_loading)
{
    <div class="text-center py-12"><div class="spinner-primary"></div></div>
}
else if (!_entries.Any())
{
    <div class="nist-card">
        <div class="nist-card-body text-center py-12">
            <p class="text-app-fg-secondary text-lg">No words found</p>
            <p class="text-app-fg-secondary text-sm mt-1">
                @if (!string.IsNullOrWhiteSpace(_searchText) || _selectedLabelId > 0)
                {
                    <span>Try adjusting your search or label filter</span>
                }
                else
                {
                    <span>Click <strong>+ New</strong> to add your first word</span>
                }
            </p>
        </div>
    </div>
}
else
{
    <!-- Desktop: Table view -->
    <div class="hidden md:block overflow-x-auto">
        <table class="nist-table">
            <thead>
                <tr>
                    <th class="w-40">Japanese</th>
                    <th class="w-36">Reading</th>
                    <th>Meaning</th>
                    <th class="w-48">Labels</th>
                    <th class="w-28">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in _entries)
                {
                    <tr>
                        <td class="text-lg font-medium">@entry.Japanese</td>
                        <td class="text-app-fg-secondary">@entry.Reading</td>
                        <td>
                            <div>@entry.Meaning</div>
                            @if (!string.IsNullOrEmpty(entry.ExampleJp))
                            {
                                <div class="text-xs text-app-fg-secondary mt-1 italic">@entry.ExampleJp</div>
                            }
                        </td>
                        <td>
                            <div class="flex flex-wrap gap-1">
                                @foreach (var label in entry.Labels)
                                {
                                    <span class="inline-block px-2 py-0.5 text-xs rounded-full text-white" style="background-color: @label.Color">@label.Name</span>
                                }
                            </div>
                        </td>
                        <td>
                            <div class="flex gap-1">
                                <button class="btn-outline text-xs !px-2 !py-1" @onclick="() => ShowEditEntry(entry)">Edit</button>
                                <button class="btn-danger text-xs !px-2 !py-1" @onclick="() => ShowDeleteConfirm(entry)">Del</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Mobile: Card view -->
    <div class="md:hidden flex flex-col gap-3">
        @foreach (var entry in _entries)
        {
            <div class="nist-card">
                <div class="nist-card-body">
                    <div class="flex justify-between items-start">
                        <div class="flex-1">
                            <div class="text-xl font-medium text-app-fg">@entry.Japanese</div>
                            @if (!string.IsNullOrEmpty(entry.Reading))
                            {
                                <div class="text-sm text-app-fg-secondary">@entry.Reading</div>
                            }
                            <div class="mt-2 text-app-fg">@entry.Meaning</div>
                            @if (!string.IsNullOrEmpty(entry.ExampleJp))
                            {
                                <div class="mt-1 text-sm text-app-fg-secondary italic">@entry.ExampleJp</div>
                            }
                            @if (!string.IsNullOrEmpty(entry.ExampleEn))
                            {
                                <div class="text-sm text-app-fg-secondary italic">@entry.ExampleEn</div>
                            }
                        </div>
                        <div class="flex gap-1 ml-2 shrink-0">
                            <button class="btn-outline text-xs !px-2 !py-1" @onclick="() => ShowEditEntry(entry)">Edit</button>
                            <button class="btn-danger text-xs !px-2 !py-1" @onclick="() => ShowDeleteConfirm(entry)">Del</button>
                        </div>
                    </div>
                    @if (entry.Labels.Any())
                    {
                        <div class="flex flex-wrap gap-1 mt-3">
                            @foreach (var label in entry.Labels)
                            {
                                <span class="inline-block px-2 py-0.5 text-xs rounded-full text-white" style="background-color: @label.Color">@label.Name</span>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(entry.Notes))
                    {
                        <div class="mt-2 text-xs text-app-fg-secondary border-t border-app-divider pt-2">@entry.Notes</div>
                    }
                </div>
            </div>
        }
    </div>
}

@* Entry Modal *@
@if (_showEntryModal)
{
    <NistAttendance.Web.Components.DictionaryEntryModal
        Entry="_editEntry"
        IsEdit="_isEdit"
        Labels="_labels"
        OnSave="HandleEntrySave"
        OnCancel="() => _showEntryModal = false" />
}

@* Delete Confirm *@
@if (_showDeleteConfirm)
{
    <div class="modal-overlay">
        <div class="modal-panel max-w-md">
            <div class="modal-header">
                <h5 class="text-lg font-semibold text-app-fg">Delete Entry</h5>
            </div>
            <div class="modal-body">
                Delete <strong class="text-lg">@_deleteTarget?.Japanese</strong> (@_deleteTarget?.Meaning)?
            </div>
            <div class="modal-footer">
                <button class="btn-outline" @onclick="() => _showDeleteConfirm = false">Cancel</button>
                <button class="btn-danger" @onclick="ConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
}

@* Label Manager *@
@if (_showLabelManager)
{
    <NistAttendance.Web.Components.LabelManager
        Labels="_labels"
        OnClose="HandleLabelManagerClose" />
}

@code {
    private List<NistAttendance.Web.Services.DictEntryDto> _entries = new();
    private List<NistAttendance.Web.Services.DictLabelDto> _labels = new();
    private bool _loading = true;
    private string _searchText = "";
    private int _selectedLabelId;

    private bool _showEntryModal;
    private bool _isEdit;
    private NistAttendance.Web.Services.DictEntryDto? _editEntry;

    private bool _showDeleteConfirm;
    private NistAttendance.Web.Services.DictEntryDto? _deleteTarget;

    private bool _showLabelManager;

    protected override async Task OnInitializedAsync()
    {
        await LoadLabels();
        await LoadEntries();
    }

    private async Task LoadEntries()
    {
        _loading = true;
        _entries = await DictService.GetEntriesAsync(
            string.IsNullOrWhiteSpace(_searchText) ? null : _searchText,
            _selectedLabelId > 0 ? _selectedLabelId : null);
        _loading = false;
    }

    private async Task LoadLabels()
    {
        _labels = await DictService.GetLabelsAsync();
    }

    private void ShowAddEntry()
    {
        _editEntry = null;
        _isEdit = false;
        _showEntryModal = true;
    }

    private void ShowEditEntry(NistAttendance.Web.Services.DictEntryDto entry)
    {
        _editEntry = entry;
        _isEdit = true;
        _showEntryModal = true;
    }

    private async Task HandleEntrySave(NistAttendance.Web.Services.DictEntryCreateDto dto)
    {
        if (_isEdit && _editEntry != null)
            await DictService.UpdateEntryAsync(_editEntry.Id, dto);
        else
            await DictService.CreateEntryAsync(dto);

        _showEntryModal = false;
        await LoadLabels();
        await LoadEntries();
    }

    private void ShowDeleteConfirm(NistAttendance.Web.Services.DictEntryDto entry)
    {
        _deleteTarget = entry;
        _showDeleteConfirm = true;
    }

    private async Task ConfirmDelete()
    {
        if (_deleteTarget != null)
        {
            await DictService.DeleteEntryAsync(_deleteTarget.Id);
            _showDeleteConfirm = false;
            await LoadLabels();
            await LoadEntries();
        }
    }

    private async Task HandleLabelManagerClose()
    {
        _showLabelManager = false;
        await LoadLabels();
        await LoadEntries();
    }
}
