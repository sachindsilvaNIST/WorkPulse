@page "/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using NistAttendance.Models
@inject NistAttendance.Web.Services.ApiSettingsService SettingsService

<h4 class="text-xl font-semibold mb-6">Settings</h4>

@if (_loading)
{
    <div class="text-center py-12">
        <div class="inline-block w-8 h-8 border-4 border-nist-primary/30 border-t-nist-primary rounded-full animate-spin"></div>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Work Schedule -->
        <div class="bg-white rounded-lg border border-gray-200">
            <div class="px-4 py-3 border-b border-gray-200 bg-gray-50 rounded-t-lg">
                <strong>Work Schedule</strong>
            </div>
            <div class="p-4 grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Standard Login</label>
                    <input type="time" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-nist-primary/40 focus:border-nist-primary" @bind="_loginTime" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Standard Logout</label>
                    <input type="time" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-nist-primary/40 focus:border-nist-primary" @bind="_logoutTime" />
                </div>
                <div class="col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">OT Break Deduction (minutes)</label>
                    <input type="number" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-nist-primary/40 focus:border-nist-primary" min="0" max="120" @bind="_breakMinutes" />
                </div>
            </div>
        </div>

        <!-- Display -->
        <div class="bg-white rounded-lg border border-gray-200">
            <div class="px-4 py-3 border-b border-gray-200 bg-gray-50 rounded-t-lg">
                <strong>Display</strong>
            </div>
            <div class="p-4 grid grid-cols-2 gap-4">
                <div class="col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Default Title</label>
                    <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-nist-primary/40 focus:border-nist-primary" @bind="_defaultTitle" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Theme</label>
                    <select class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-nist-primary/40 focus:border-nist-primary" @bind="_theme">
                        <option value="Light">Light</option>
                        <option value="Dark">Dark</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Font Size</label>
                    <select class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-nist-primary/40 focus:border-nist-primary" @bind="_fontSize">
                        <option value="Small">Small</option>
                        <option value="Medium">Medium</option>
                        <option value="Large">Large</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Save -->
        <div class="col-span-1 md:col-span-2">
            <button class="bg-nist-primary hover:bg-nist-primary-dark text-white font-medium py-2 px-6 rounded-md transition-colors disabled:opacity-50" @onclick="SaveSettings" disabled="@_saving">
                @if (_saving) { <span class="inline-block w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin mr-2 align-middle"></span> }
                Save Settings
            </button>

            @if (_saved)
            {
                <span class="text-green-600 ml-3">Settings saved.</span>
            }
            @if (!string.IsNullOrEmpty(_error))
            {
                <span class="text-red-600 ml-3">@_error</span>
            }
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private bool _saved;
    private string? _error;

    private TimeOnly _loginTime = new(8, 20);
    private TimeOnly _logoutTime = new(17, 25);
    private int _breakMinutes = 20;
    private string _defaultTitle = "MSW SETTLEMENT";
    private string _theme = "Light";
    private string _fontSize = "Medium";

    protected override async Task OnInitializedAsync()
    {
        var s = await SettingsService.LoadAsync();
        _loginTime = s.StandardLoginTime;
        _logoutTime = s.StandardLogoutTime;
        _breakMinutes = s.OvertimeBreakDeductionMinutes;
        _defaultTitle = s.DefaultTitle;
        _theme = s.ThemeVariant;
        _fontSize = s.FontSizePreset;
        _loading = false;
    }

    private async Task SaveSettings()
    {
        _saving = true;
        _saved = false;
        _error = null;

        try
        {
            var settings = new AppSettings
            {
                StandardLoginTime = _loginTime,
                StandardLogoutTime = _logoutTime,
                OvertimeBreakDeductionMinutes = _breakMinutes,
                DefaultTitle = _defaultTitle,
                ThemeVariant = _theme,
                FontSizePreset = _fontSize
            };
            await SettingsService.SaveAsync(settings);
            _saved = true;
        }
        catch (Exception ex)
        {
            _error = $"Failed to save: {ex.Message}";
        }

        _saving = false;
    }
}
