@page "/"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="text-center mt-12">
    <h1 class="text-3xl font-bold text-app-fg">NIST Workspace</h1>
    <p class="text-app-fg-secondary mt-2">Attendance Management System</p>

    <div class="flex justify-center gap-6 mt-10">
        <div class="w-72">
            <div class="nist-card hover:shadow-md transition-shadow h-full">
                <div class="nist-card-body text-center">
                    <svg class="w-12 h-12 mx-auto text-nist-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                    <h5 class="text-lg font-semibold mt-4 text-app-fg">Attendance</h5>
                    <p class="text-sm text-app-fg-secondary mt-2">Track daily attendance, overtime, and business trips</p>
                    <a href="dashboard" class="btn-primary mt-4">Open Dashboard</a>
                </div>
            </div>
        </div>
        <div class="w-72">
            <div class="nist-card hover:shadow-md transition-shadow h-full">
                <div class="nist-card-body text-center">
                    <svg class="w-12 h-12 mx-auto text-nist-success" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                    <h5 class="text-lg font-semibold mt-4 text-app-fg">Contacts</h5>
                    <p class="text-sm text-app-fg-secondary mt-2">Manage your professional contact book</p>
                    <a href="contacts" class="btn-green mt-4">Open Contacts</a>
                </div>
            </div>
        </div>
    </div>
</div>
