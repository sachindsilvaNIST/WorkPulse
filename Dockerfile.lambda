# Lambda container image for WorkPulse.Api — separate from the root ./Dockerfile (which Render's
# render.yaml still points at) so the existing Render deployment stays available as a rollback
# fallback during cutover. AWS's own base image provides the Lambda runtime interface client;
# with Amazon.Lambda.AspNetCoreServer.Hosting (AddAWSLambdaHosting in Program.cs) the handler is
# just the assembly name, not a classic Assembly::Namespace.Class::Method string.
FROM public.ecr.aws/lambda/dotnet:8 AS base

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY WorkPulse.Shared/WorkPulse.Shared.csproj WorkPulse.Shared/
COPY WorkPulse.Api/WorkPulse.Api.csproj WorkPulse.Api/
RUN dotnet restore WorkPulse.Api/WorkPulse.Api.csproj

COPY WorkPulse.Shared/ WorkPulse.Shared/
COPY WorkPulse.Api/ WorkPulse.Api/
RUN dotnet publish WorkPulse.Api/WorkPulse.Api.csproj -c Release -o /app/publish

FROM base AS final
WORKDIR /var/task
COPY --from=build /app/publish .

CMD ["WorkPulse.Api"]
