<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NistAttendance.App"
             xmlns:local="using:NistAttendance"
>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackground" Color="White"/>
                    <SolidColorBrush x:Key="AppBackgroundAlt" Color="#F5F5F5"/>
                    <SolidColorBrush x:Key="AppForeground" Color="#333333"/>
                    <SolidColorBrush x:Key="AppForegroundSecondary" Color="#666666"/>
                    <SolidColorBrush x:Key="AppDivider" Color="#E0E0E0"/>
                    <SolidColorBrush x:Key="AppControlHover" Color="White"/>
                    <SolidColorBrush x:Key="AppInfoPanel" Color="#FFF3E0"/>
                    <SolidColorBrush x:Key="AppSuccessPanel" Color="#E8F5E9"/>
                    <SolidColorBrush x:Key="AppErrorPanel" Color="#FDECEA"/>
                    <SolidColorBrush x:Key="AppButtonNeutral" Color="#E5E5EA"/>
                    <SolidColorBrush x:Key="AppInputBackground" Color="White"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackground" Color="#1E1E1E"/>
                    <SolidColorBrush x:Key="AppBackgroundAlt" Color="#2D2D2D"/>
                    <SolidColorBrush x:Key="AppForeground" Color="#E0E0E0"/>
                    <SolidColorBrush x:Key="AppForegroundSecondary" Color="#999999"/>
                    <SolidColorBrush x:Key="AppDivider" Color="#404040"/>
                    <SolidColorBrush x:Key="AppControlHover" Color="#3D3D3D"/>
                    <SolidColorBrush x:Key="AppInfoPanel" Color="#3D2E00"/>
                    <SolidColorBrush x:Key="AppSuccessPanel" Color="#1B3D1F"/>
                    <SolidColorBrush x:Key="AppErrorPanel" Color="#3D1418"/>
                    <SolidColorBrush x:Key="AppButtonNeutral" Color="#404040"/>
                    <SolidColorBrush x:Key="AppInputBackground" Color="#2D2D2D"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <x:Double x:Key="DefaultFontSize">14</x:Double>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- Button hover/press animations -->
        <Style Selector="Button">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Opacity" Value="1.0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.8" Easing="CubicEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="RenderTransform">
                <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
            </Setter>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="RenderTransform">
                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
            </Setter>
        </Style>
    </Application.Styles>
</Application>
