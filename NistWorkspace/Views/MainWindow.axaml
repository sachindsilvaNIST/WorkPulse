<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NistAttendance.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1500" d:DesignHeight="1080"
        x:Class="NistAttendance.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="NIST Workspace"
        Width="1500" Height="900"
        MinWidth="800" MinHeight="500">

    <DockPanel>
        <!-- Top Toolbar (hidden on Home screen) -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1" Padding="12,8"
                IsVisible="{Binding CurrentViewName, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=True}"
                x:Name="ToolbarBorder">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Home Button + Section Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <Button Content="Home" Command="{Binding GoHomeCommand}"
                            Padding="10,5" FontWeight="SemiBold"
                            Background="#6E6E6E" Foreground="White"
                            ToolTip.Tip="Back to Home"/>
                    <TextBlock x:Name="SectionTitle" Text="Attendance Management"
                               FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="#333333"/>
                </StackPanel>

                <!-- Toolbar Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">

                    <!-- ===== ATTENDANCE TOOLBAR ===== -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                x:Name="AttendanceToolbar" IsVisible="False">
                        <!-- Edit Mode Toggle -->
                        <Button Content="{Binding AttendanceDashboard.EditModeButtonText, FallbackValue=Edit}"
                                Command="{Binding AttendanceDashboard.ToggleEditModeCommand}"
                                Padding="14,6" FontWeight="Bold"
                                Background="#0078D4" Foreground="White"
                                ToolTip.Tip="Toggle Edit Mode"/>

                        <Border Width="1" Background="#E0E0E0" Margin="4,2"/>

                        <!-- CRUD buttons (visible only in Edit Mode) -->
                        <Button Content="+ Entry" Command="{Binding AddEntryCommand}"
                                IsVisible="{Binding AttendanceDashboard.IsEditMode, FallbackValue=False}"
                                Padding="12,6"
                                Background="#007AFF" Foreground="White"
                                ToolTip.Tip="Add new attendance entry"/>
                        <Button Content="+ Holiday" Command="{Binding AddHolidayCommand}"
                                IsVisible="{Binding AttendanceDashboard.IsEditMode, FallbackValue=False}"
                                Padding="12,6"
                                Background="#107C10" Foreground="White"
                                ToolTip.Tip="Add a holiday"/>
                        <Button Content="Edit Row" Command="{Binding EditSelectedEntryCommand}"
                                IsVisible="{Binding AttendanceDashboard.IsEditMode, FallbackValue=False}"
                                Padding="12,6"
                                Background="#106EBE" Foreground="White"
                                ToolTip.Tip="Edit selected entry"/>
                        <Button Content="Delete" Command="{Binding DeleteEntryCommand}"
                                IsVisible="{Binding AttendanceDashboard.IsEditMode, FallbackValue=False}"
                                Padding="12,6"
                                Background="#D13438" Foreground="White"
                                ToolTip.Tip="Delete selected entry"/>

                        <Border Width="1" Background="#E0E0E0" Margin="4,2"
                                IsVisible="{Binding AttendanceDashboard.IsEditMode, FallbackValue=False}"/>
                    </StackPanel>

                    <!-- ===== CONTACTS TOOLBAR ===== -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                x:Name="ContactsToolbar" IsVisible="False">
                        <!-- Edit Mode Toggle -->
                        <Button Content="{Binding ContactBookDashboard.EditModeButtonText, FallbackValue=Edit}"
                                Command="{Binding ContactBookDashboard.ToggleEditModeCommand}"
                                Padding="14,6" FontWeight="Bold"
                                Background="#0078D4" Foreground="White"
                                ToolTip.Tip="Toggle Edit Mode"/>

                        <Border Width="1" Background="#E0E0E0" Margin="4,2"/>

                        <!-- CRUD buttons (visible only in Edit Mode) -->
                        <Button Content="+ Add" Command="{Binding AddContactCommand}"
                                IsVisible="{Binding ContactBookDashboard.IsEditMode, FallbackValue=False}"
                                Padding="12,6"
                                Background="#007AFF" Foreground="White"
                                ToolTip.Tip="Add new contact"/>
                        <Button Content="Edit Contact" Command="{Binding EditContactCommand}"
                                IsVisible="{Binding ContactBookDashboard.IsEditMode, FallbackValue=False}"
                                Padding="12,6"
                                Background="#106EBE" Foreground="White"
                                ToolTip.Tip="Edit selected contact"/>
                        <Button Content="Delete" Command="{Binding DeleteEntryCommand}"
                                IsVisible="{Binding ContactBookDashboard.IsEditMode, FallbackValue=False}"
                                Padding="12,6"
                                Background="#D13438" Foreground="White"
                                ToolTip.Tip="Delete selected contact"/>

                        <Border Width="1" Background="#E0E0E0" Margin="4,2"
                                IsVisible="{Binding ContactBookDashboard.IsEditMode, FallbackValue=False}"/>
                    </StackPanel>

                    <!-- ===== Import / Export ===== -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                x:Name="ImportExportToolbar" IsVisible="False">
                        <Button x:Name="ImportExcelBtn"
                                Content="Import Excel" Command="{Binding ImportExcelCommand}"
                                Padding="12,6"
                                Background="#FF8C00" Foreground="White"
                                ToolTip.Tip="Import from Excel file"/>
                        <Button Content="Export Excel" Command="{Binding ExportExcelCommand}"
                                Padding="12,6"
                                Background="#107C10" Foreground="White"
                                ToolTip.Tip="Export to Excel file"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="#F5F5F5" BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#666666"/>
        </Border>

        <!-- Dynamic Content Area -->
        <Border Padding="16">
            <ContentControl Content="{Binding CurrentView}"/>
        </Border>
    </DockPanel>
</Window>
