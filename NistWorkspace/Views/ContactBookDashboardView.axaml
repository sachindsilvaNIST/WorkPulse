<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NistAttendance.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="600"
             x:Class="NistAttendance.Views.ContactBookDashboardView"
             x:DataType="vm:ContactBookDashboardViewModel">

    <DockPanel>
        <!-- Search Bar + Summary -->
        <Border DockPanel.Dock="Top" Padding="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Search Box -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText}"
                         Watermark="Search by name, department, affiliation, email..."
                         FontSize="14"
                         Padding="12,8"
                         CornerRadius="6"
                         BorderBrush="#D0D0D0"
                         Margin="0,0,16,0"/>

                <!-- Summary -->
                <Border Grid.Column="1" Background="#F5F5F5" CornerRadius="6" Padding="16,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Total:" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="#555555"/>
                        <TextBlock Text="{Binding TotalContacts}" FontWeight="Bold"
                                   VerticalAlignment="Center" FontSize="16"
                                   Foreground="#0078D4"/>
                        <TextBlock Text="contacts" VerticalAlignment="Center"
                                   Foreground="#555555"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <DataGrid ItemsSource="{Binding FilteredContacts}"
                  SelectedItem="{Binding SelectedContact}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="False"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="#E0E0E0"
                  CornerRadius="6"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  FontSize="14"
                  RowHeight="36">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Affiliation" Binding="{Binding Affiliation}" Width="150"/>
                <DataGridTextColumn Header="Family Name (性)" Binding="{Binding FamilyName}" Width="130"/>
                <DataGridTextColumn Header="Given Name (名)" Binding="{Binding GivenName}" Width="130"/>
                <DataGridTextColumn Header="Department (部名)" Binding="{Binding Department}" Width="180"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220"/>
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
