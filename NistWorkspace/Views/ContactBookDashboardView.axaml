<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NistAttendance.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="600"
             x:Class="NistAttendance.Views.ContactBookDashboardView"
             x:DataType="vm:ContactBookDashboardViewModel">

    <DockPanel>
        <!-- Search Bar + Summary -->
        <Border DockPanel.Dock="Top" Padding="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <!-- Search Box -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText}"
                         Watermark="Search by name, department, affiliation, email..."
                         FontSize="14"
                         Padding="12,8"
                         CornerRadius="6"
                         BorderBrush="#D0D0D0"
                         Margin="0,0,8,0"/>

                <!-- Clear Search Button -->
                <Button Grid.Column="1"
                        Command="{Binding ClearSearchCommand}"
                        Padding="8,6"
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        ToolTip.Tip="Clear search">
                    <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                              Width="16" Height="16"
                              Foreground="#999999"/>
                </Button>

                <!-- Summary -->
                <Border Grid.Column="2" Background="#F5F5F5" CornerRadius="6" Padding="16,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Total:" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="#555555"/>
                        <TextBlock Text="{Binding TotalContacts}" FontWeight="Bold"
                                   VerticalAlignment="Center" FontSize="16"
                                   Foreground="#0078D4"/>
                        <TextBlock Text="contacts" VerticalAlignment="Center"
                                   Foreground="#555555"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- DataGrid + Empty State -->
        <Grid>
        <DataGrid ItemsSource="{Binding FilteredContacts}"
                  SelectedItem="{Binding SelectedContact}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="False"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="#E0E0E0"
                  CornerRadius="6"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  FontSize="14">
            <DataGrid.Styles>
                <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
                    <Setter Property="Fill" Value="#007AFF"/>
                    <Setter Property="Opacity" Value="1"/>
                </Style>
                <Style Selector="DataGridRow:selected /template/ Rectangle#InvalidVisualElement">
                    <Setter Property="Fill" Value="#007AFF"/>
                </Style>
                <Style Selector="DataGridRow:selected DataGridCell TextBlock">
                    <Setter Property="Foreground" Value="White"/>
                </Style>
                <Style Selector="DataGridRow:selected DataGridCell SelectableTextBlock">
                    <Setter Property="Foreground" Value="White"/>
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Affiliation" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <SelectableTextBlock Text="{Binding Affiliation}" TextWrapping="Wrap"
                                                 VerticalAlignment="Center" Padding="8,6">
                                <SelectableTextBlock.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy" Click="CopyCell_Click" InputGesture="Ctrl+C"/>
                                    </ContextMenu>
                                </SelectableTextBlock.ContextMenu>
                            </SelectableTextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Family Name (性)" Width="155">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <SelectableTextBlock Text="{Binding FamilyName}"
                                                 VerticalAlignment="Center" Padding="8,6">
                                <SelectableTextBlock.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy" Click="CopyCell_Click" InputGesture="Ctrl+C"/>
                                    </ContextMenu>
                                </SelectableTextBlock.ContextMenu>
                            </SelectableTextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Given Name (名)" Width="155">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <SelectableTextBlock Text="{Binding GivenName}"
                                                 VerticalAlignment="Center" Padding="8,6">
                                <SelectableTextBlock.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy" Click="CopyCell_Click" InputGesture="Ctrl+C"/>
                                    </ContextMenu>
                                </SelectableTextBlock.ContextMenu>
                            </SelectableTextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Department (部名)" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <SelectableTextBlock Text="{Binding Department}" TextWrapping="Wrap"
                                                 VerticalAlignment="Center" Padding="8,6">
                                <SelectableTextBlock.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy" Click="CopyCell_Click" InputGesture="Ctrl+C"/>
                                    </ContextMenu>
                                </SelectableTextBlock.ContextMenu>
                            </SelectableTextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Email" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <SelectableTextBlock Text="{Binding Email}" TextWrapping="Wrap"
                                                 VerticalAlignment="Center" Padding="8,6">
                                <SelectableTextBlock.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy" Click="CopyCell_Click" InputGesture="Ctrl+C"/>
                                    </ContextMenu>
                                </SelectableTextBlock.ContextMenu>
                            </SelectableTextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Intercom" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <SelectableTextBlock Text="{Binding Intercom}"
                                                 VerticalAlignment="Center" Padding="8,6">
                                <SelectableTextBlock.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy" Click="CopyCell_Click" InputGesture="Ctrl+C"/>
                                    </ContextMenu>
                                </SelectableTextBlock.ContextMenu>
                            </SelectableTextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Contact Number" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <SelectableTextBlock Text="{Binding ContactNumber}"
                                                 VerticalAlignment="Center" Padding="8,6">
                                <SelectableTextBlock.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy" Click="CopyCell_Click" InputGesture="Ctrl+C"/>
                                    </ContextMenu>
                                </SelectableTextBlock.ContextMenu>
                            </SelectableTextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Notes" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <SelectableTextBlock Text="{Binding Notes}" TextWrapping="Wrap"
                                                 VerticalAlignment="Center" Padding="8,6">
                                <SelectableTextBlock.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy" Click="CopyCell_Click" InputGesture="Ctrl+C"/>
                                    </ContextMenu>
                                </SelectableTextBlock.ContextMenu>
                            </SelectableTextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- No Search Results Message -->
        <TextBlock Text="Opss! No search contact(s) found."
                   IsVisible="{Binding HasNoSearchResults}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="18"
                   Foreground="#999999"
                   FontWeight="SemiBold"/>
        </Grid>
    </DockPanel>
</UserControl>
