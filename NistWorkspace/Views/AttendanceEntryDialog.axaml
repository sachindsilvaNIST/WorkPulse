<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NistAttendance.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="700"
        x:Class="NistAttendance.Views.AttendanceEntryDialog"
        x:DataType="vm:AttendanceEntryViewModel"
        Title="{Binding WindowTitle}"
        Width="560" Height="700"
        MinWidth="560" MinHeight="660"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundAlt}">

    <Window.Styles>
        <!-- Remove scale animation from DatePicker flyout button -->
        <Style Selector="DatePicker /template/ Button">
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Transitions" Value="{x:Null}"/>
        </Style>
        <Style Selector="DatePicker /template/ Button:pressed">
            <Setter Property="RenderTransform" Value="none"/>
        </Style>
        <Style Selector="DatePicker /template/ Button:pointerover">
            <Setter Property="RenderTransform" Value="none"/>
        </Style>
    </Window.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Padding="28">
            <StackPanel Spacing="18">
                <!-- Date Picker -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Date" FontWeight="SemiBold" Foreground="{DynamicResource AppForeground}"/>
                    <DatePicker SelectedDate="{Binding SelectedDate}"/>
                </StackPanel>

                <!-- Day Type -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Type" FontWeight="SemiBold" Foreground="{DynamicResource AppForeground}"/>
                    <ComboBox x:Name="DayTypeCombo" SelectedIndex="0"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- Holiday/Leave Name (visible for leave types that support a name) -->
                <StackPanel Spacing="6" IsVisible="{Binding ShowHolidayName}">
                    <TextBlock Text="Description (optional)" FontWeight="SemiBold" Foreground="{DynamicResource AppForeground}"/>
                    <TextBox Text="{Binding HolidayName}" Watermark="e.g., NEW YEAR HOLIDAY"/>
                </StackPanel>

                <!-- Business Trip Fields -->
                <StackPanel Spacing="12" IsVisible="{Binding ShowBusinessTripFields}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Scheduled Departure Date" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppForeground}"/>
                        <DatePicker SelectedDate="{Binding DepartureDate}"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Scheduled Return Date" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppForeground}"/>
                        <DatePicker SelectedDate="{Binding ReturnDate}"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Business Trip Location(s)" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppForeground}"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding NewLocationText}"
                                     Watermark="e.g., Osaka" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="+ Add"
                                    Command="{Binding AddLocationCommand}"
                                    Padding="14,7" FontWeight="SemiBold"
                                    Background="#0078D4" Foreground="White"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding TripLocations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource AppBackgroundAlt}"
                                            CornerRadius="4" Padding="10,6" Margin="0,2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AppForeground}"/>
                                            <Button Grid.Column="1" Content="X"
                                                    Command="{Binding $parent[ItemsControl].((vm:AttendanceEntryViewModel)DataContext).RemoveLocationCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="8,2" FontSize="11"
                                                    Background="#D13438" Foreground="White"
                                                    CornerRadius="3"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Login Time (visible only for work days) -->
                <StackPanel Spacing="6" IsVisible="{Binding IsWorkDay}">
                    <TextBlock Text="Login Time (default: 08:20)" FontWeight="SemiBold" Foreground="{DynamicResource AppForeground}"/>
                    <Border Background="{DynamicResource AppInputBackground}" BorderBrush="{DynamicResource AppDivider}" BorderThickness="1"
                            CornerRadius="4" Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto,*,Auto">
                            <NumericUpDown Grid.Column="0" Value="{Binding LoginHour}"
                                           Minimum="0" Maximum="23" FormatString="00"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text=" : " VerticalAlignment="Center"
                                       FontSize="20" FontWeight="Bold" Margin="8,0"/>
                            <NumericUpDown Grid.Column="2" Value="{Binding LoginMinute}"
                                           Minimum="0" Maximum="59" FormatString="00"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="  (24h)" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppForegroundSecondary}" FontSize="12" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Logout Time (visible only for work days) -->
                <StackPanel Spacing="6" IsVisible="{Binding IsWorkDay}">
                    <TextBlock Text="Logout Time (default: 17:25)" FontWeight="SemiBold" Foreground="{DynamicResource AppForeground}"/>
                    <Border Background="{DynamicResource AppInputBackground}" BorderBrush="{DynamicResource AppDivider}" BorderThickness="1"
                            CornerRadius="4" Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto,*,Auto">
                            <NumericUpDown Grid.Column="0" Value="{Binding LogoutHour}"
                                           Minimum="0" Maximum="23" FormatString="00"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text=" : " VerticalAlignment="Center"
                                       FontSize="20" FontWeight="Bold" Margin="8,0"/>
                            <NumericUpDown Grid.Column="2" Value="{Binding LogoutMinute}"
                                           Minimum="0" Maximum="59" FormatString="00"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="  (24h)" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppForegroundSecondary}" FontSize="12" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Overtime Dropdown -->
                <StackPanel Spacing="6" IsVisible="{Binding IsWorkDay}">
                    <TextBlock Text="Overtime?" FontWeight="SemiBold" Foreground="{DynamicResource AppForeground}"/>
                    <ComboBox x:Name="OtCombo" HorizontalAlignment="Stretch" SelectedIndex="-1">
                        <ComboBoxItem Content="Yes"/>
                        <ComboBoxItem Content="No"/>
                    </ComboBox>
                </StackPanel>

                <!-- Overtime End Time Picker (visible only when Overtime = Yes) -->
                <Border Background="{DynamicResource AppInfoPanel}" Padding="16" CornerRadius="6"
                        IsVisible="{Binding ShowOvertimeTimePicker}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Overtime End Time (when you actually left)"
                                   FontWeight="SemiBold" Foreground="{DynamicResource AppForeground}"/>
                        <Border Background="{DynamicResource AppInputBackground}" BorderBrush="{DynamicResource AppDivider}" BorderThickness="1"
                                CornerRadius="4" Padding="12,8">
                            <Grid ColumnDefinitions="*,Auto,*,Auto">
                                <NumericUpDown Grid.Column="0" Value="{Binding OtEndHour}"
                                               Minimum="0" Maximum="23" FormatString="00"
                                               HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text=" : " VerticalAlignment="Center"
                                           FontSize="20" FontWeight="Bold" Margin="8,0"/>
                                <NumericUpDown Grid.Column="2" Value="{Binding OtEndMinute}"
                                               Minimum="0" Maximum="59" FormatString="00"
                                               HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="  (24h)" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppForegroundSecondary}" FontSize="12" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Overtime Calculation Result -->
                        <TextBlock Text="{Binding OvertimeResultText}" FontWeight="Bold"
                                   Foreground="#E65100" IsVisible="{Binding IsOvertimeDecided}"/>

                        <!-- Confirm / Cancel Overtime buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding CancelOvertimeCommand}"
                                    Padding="16,7" Background="{DynamicResource AppButtonNeutral}" Foreground="{DynamicResource AppForeground}"/>
                            <Button Content="Confirm" Command="{Binding ConfirmOvertimeCommand}"
                                    Padding="16,7" FontWeight="Bold"
                                    Background="#107C10" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Overtime result display (No overtime / calculated Overtime) -->
                <Border Background="{DynamicResource AppSuccessPanel}" Padding="12" CornerRadius="4"
                        IsVisible="{Binding IsOvertimeDecided}">
                    <TextBlock Text="{Binding OvertimeResultText}" FontWeight="SemiBold"
                               Foreground="#2E7D32"/>
                </Border>

                <!-- Validation Error -->
                <Border Background="{DynamicResource AppErrorPanel}" Padding="12" CornerRadius="4"
                        IsVisible="{Binding HasValidationError}">
                    <TextBlock Text="{Binding ValidationError}" FontWeight="SemiBold"
                               Foreground="#D13438"/>
                </Border>

                <!-- Save / Cancel Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                            Padding="24,9" MinWidth="100"
                            Background="#D13438" Foreground="White"/>
                    <Button Content="Save" Command="{Binding SaveCommand}"
                            Padding="24,9" MinWidth="100" FontWeight="Bold"
                            Background="#107C10" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
