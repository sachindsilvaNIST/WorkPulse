<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NistAttendance.ViewModels"
             xmlns:conv="using:NistAttendance.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="NistAttendance.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <UserControl.Resources>
        <conv:OvertimeFlagToBackgroundConverter x:Key="OtBgConverter"/>
        <conv:OvertimeFlagToForegroundConverter x:Key="OtFgConverter"/>
    </UserControl.Resources>

    <DockPanel>
        <!-- Month Navigation + Edit Mode Indicator + Save -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
            <!-- Month Navigation -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="&#9664;" Command="{Binding NavigateMonthCommand}" CommandParameter="prev"
                        FontSize="16" Padding="8,4" ToolTip.Tip="Previous Month"/>
                <TextBlock Text="{Binding MonthYearDisplay}" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" MinWidth="200" TextAlignment="Center"/>
                <Button Content="&#9654;" Command="{Binding NavigateMonthCommand}" CommandParameter="next"
                        FontSize="16" Padding="8,4" ToolTip.Tip="Next Month"/>
            </StackPanel>

            <!-- Edit Mode Indicator + Save Button -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- Edit Mode Badge -->
                <Border IsVisible="{Binding IsEditMode}"
                        Padding="12,4" CornerRadius="4">
                    <Border.Background>
                        <SolidColorBrush Color="#FFF3E0"/>
                    </Border.Background>
                    <TextBlock Text="EDIT MODE" FontWeight="Bold" Foreground="#FF8C00" FontSize="13"/>
                </Border>

                <!-- Save Button (visible in edit mode) -->
                <Button Content="Save" Command="{Binding SaveAllChangesCommand}"
                        IsVisible="{Binding IsEditMode}"
                        Padding="16,6" FontWeight="Bold"
                        Background="#107C10" Foreground="White"
                        ToolTip.Tip="Save all changes to disk"/>
            </StackPanel>
        </Grid>

        <!-- Summary Panel -->
        <Border DockPanel.Dock="Bottom" Background="#F5F5F5" Padding="16" CornerRadius="6" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Spacing="48">
                <StackPanel>
                    <TextBlock Text="Work Days" FontSize="12" Foreground="#666666"/>
                    <TextBlock Text="{Binding TotalWorkDays}" FontSize="24" FontWeight="Bold" Foreground="#0078D4"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Overtime Count" FontSize="12" Foreground="#666666"/>
                    <TextBlock Text="{Binding OvertimeCount}" FontSize="24" FontWeight="Bold" Foreground="#FF8C00"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Total Overtime" FontSize="12" Foreground="#666666"/>
                    <TextBlock Text="{Binding TotalOvertimeDuration}" FontSize="24" FontWeight="Bold" Foreground="#D13438"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Attendance DataGrid -->
        <DataGrid x:Name="AttendanceGrid"
                  ItemsSource="{Binding Records}"
                  SelectedItem="{Binding SelectedRecord}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="False"
                  CanUserResizeColumns="False"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="#E0E0E0"
                  CornerRadius="6"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  FontSize="14"
                  RowHeight="36">
            <DataGrid.Columns>
                <DataGridTextColumn Header="DAY" Binding="{Binding DayAbbreviation}" Width="70"
                                    FontWeight="SemiBold" IsReadOnly="True"/>
                <DataGridTextColumn Header="DATE" Binding="{Binding Date}" Width="120"
                                    IsReadOnly="True"/>
                <DataGridTextColumn Header="LOGIN" Binding="{Binding LoginDisplay}" Width="120"/>
                <DataGridTextColumn Header="LOGOUT" Binding="{Binding LogoutDisplay}" Width="110"/>
                <DataGridTextColumn Header="Overtime Hours" Binding="{Binding OvertimeHoursDisplay}" Width="145"/>
                <DataGridTextColumn Header="Overtime Minutes" Binding="{Binding OvertimeMinutesDisplay}" Width="145"/>
                <DataGridTemplateColumn Header="Overtime" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding OvertimeFlag, Converter={StaticResource OtBgConverter}}"
                                    CornerRadius="3" Margin="2,2" Padding="8,0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <TextBlock Text="{Binding OvertimeFlag}"
                                           Foreground="{Binding OvertimeFlag, Converter={StaticResource OtFgConverter}}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           FontWeight="Bold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
