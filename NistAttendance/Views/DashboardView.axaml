<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NistAttendance.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="NistAttendance.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <DockPanel>
        <!-- Month Navigation + Quick Actions -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
            <!-- Month Navigation -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="&#9664;" Command="{Binding NavigateMonthCommand}" CommandParameter="prev"
                        FontSize="16" Padding="8,4" ToolTip.Tip="Previous Month"/>
                <TextBlock Text="{Binding MonthYearDisplay}" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" MinWidth="200" TextAlignment="Center"/>
                <Button Content="&#9654;" Command="{Binding NavigateMonthCommand}" CommandParameter="next"
                        FontSize="16" Padding="8,4" ToolTip.Tip="Next Month"/>
            </StackPanel>

            <!-- Quick Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Login Now" Command="{Binding LoginNowCommand}"
                        Classes="accent" Padding="16,8" FontWeight="Bold"/>
                <Button Content="Logout Now" Command="{Binding LogoutNowCommand}"
                        Classes="accent" Padding="16,8" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <!-- Summary Panel -->
        <Border DockPanel.Dock="Bottom" Background="#F5F5F5" Padding="16" CornerRadius="6" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Spacing="48">
                <StackPanel>
                    <TextBlock Text="Work Days" FontSize="12" Foreground="Gray"/>
                    <TextBlock Text="{Binding TotalWorkDays}" FontSize="24" FontWeight="Bold" Foreground="#2196F3"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Overtime Count" FontSize="12" Foreground="Gray"/>
                    <TextBlock Text="{Binding OvertimeCount}" FontSize="24" FontWeight="Bold" Foreground="#FF9800"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Total Overtime" FontSize="12" Foreground="Gray"/>
                    <TextBlock Text="{Binding TotalOvertimeDuration}" FontSize="24" FontWeight="Bold" Foreground="#F44336"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Attendance DataGrid -->
        <DataGrid ItemsSource="{Binding Records}"
                  SelectedItem="{Binding SelectedRecord}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="False"
                  CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="#E0E0E0"
                  CornerRadius="6"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  FontSize="14"
                  RowHeight="36">
            <DataGrid.Columns>
                <DataGridTextColumn Header="DAY" Binding="{Binding DayAbbreviation}" Width="60"
                                    FontWeight="SemiBold"/>
                <DataGridTextColumn Header="DATE" Binding="{Binding Date}" Width="110"/>
                <DataGridTextColumn Header="LOGIN" Binding="{Binding LoginDisplay}" Width="100"/>
                <DataGridTextColumn Header="LOGOUT" Binding="{Binding LogoutDisplay}" Width="100"/>
                <DataGridTextColumn Header="OT Hr" Binding="{Binding OvertimeHoursDisplay}" Width="65"/>
                <DataGridTextColumn Header="OT Min" Binding="{Binding OvertimeMinutesDisplay}" Width="65"/>
                <DataGridTextColumn Header="OT" Binding="{Binding OvertimeFlag}" Width="55"/>
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
